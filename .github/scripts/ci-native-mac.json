{
  "ciInputs": [
    ".github/workflows/ci.yml",
    ".github/actions",
    ".github/scripts/ci-changes.mjs",
    ".github/scripts/ci-native-mac.json"
  ],
  "nodeInputs": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    ".pnpmfile.cjs",
    "patches"
  ],
  "tasks": [
    {
      "task": "computer-helper",
      "timeout": 6,
      "swift": [
        "apps/desktop/native/computer-use",
        "packages/apple-data",
        "packages/macos-signing",
        "apps/desktop/scripts/build-computer-use-helper.ts"
      ],
      "scripts": ["apps/desktop/scripts/build-computer-use-helper.ts"],
      "extra": ["apps/desktop/package.json", "apps/web/public/computer-use.png"]
    },
    {
      "task": "passwords-helper",
      "timeout": 8,
      "swift": [
        "apps/desktop/native/passwords",
        "packages/macos-signing",
        "apps/desktop/scripts/build-passwords-broker.ts"
      ],
      "scripts": ["apps/desktop/scripts/build-passwords-broker.ts"],
      "extra": ["apps/desktop/package.json", "apps/web/public/opensteer.png"]
    },
    {
      "task": "iphone",
      "timeout": 6,
      "swift": [
        "packages/apple-data",
        "apps/mobile/modules/iphone-apps/ios",
        "apps/mobile/modules/dictation/ios/Package.swift",
        "apps/mobile/modules/dictation/ios/Sources",
        "apps/mobile/modules/dictation/ios/Tests"
      ],
      "tests": [
        "packages/apple-data",
        "apps/mobile/modules/iphone-apps/ios",
        "apps/mobile/modules/dictation/ios"
      ],
      "scripts": [
        "scripts/generate-apple-data-contracts.ts",
        "apps/desktop/src/computer-use/lifecycle-lock-holder.fixture.ts"
      ],
      "vitest": [
        "tests/helper-data-contracts.test.ts",
        "packages/protocol/src/computer-use-helper-wire.test.ts",
        "packages/protocol/src/passwords-broker-wire.test.ts",
        "apps/desktop/src/computer-use/",
        "apps/desktop/src/passwords/"
      ],
      "extra": [
        ".github/scripts/ci-access-trace.mjs",
        ".github/scripts/ci-native-access.mjs",
        ".github/scripts/ci-test-files.mjs",
        "scripts/ci-inventory-reporter.ts",
        "scripts/mac-app-tree.py",
        "scripts/install.sh",
        "apps/desktop/native/computer-use/Tests/Fixtures/helper-wire.json",
        "apps/desktop/native/passwords/Tests/Fixtures/passwords-wire.json"
      ],
      "lane": true
    },
    {
      "task": "computer-tests",
      "timeout": 6,
      "swift": [
        "apps/desktop/native/computer-use",
        "packages/apple-data",
        "packages/macos-signing"
      ],
      "tests": ["apps/desktop/native/computer-use"],
      "scripts": ["scripts/generate-apple-data-contracts.ts"],
      "extra": ["packages/protocol/fixtures/login-envelope-v1.json"]
    },
    {
      "task": "passwords-tests",
      "timeout": 14,
      "swift": ["apps/desktop/native/passwords", "packages/macos-signing"],
      "tests": ["apps/desktop/native/passwords", "packages/macos-signing"],
      "extra": ["apps/desktop/src/passwords/paths.ts", "packages/client/src/host/passwords.ts"]
    },
    {
      "task": "dictation",
      "timeout": 8,
      "swift": ["packages/apple-dictation"],
      "tests": ["packages/apple-dictation"],
      "xcode": "/Applications/Xcode_26.3.app/Contents/Developer"
    },
    {
      "task": "dictation-helper",
      "timeout": 8,
      "xcode": "/Applications/Xcode_26.3.app/Contents/Developer",
      "swift": [
        "apps/desktop/native/dictation",
        "packages/apple-dictation",
        "packages/macos-signing"
      ],
      "tests": ["apps/desktop/native/dictation"],
      "scripts": ["apps/desktop/scripts/build-dictation-helper.ts"],
      "extra": ["apps/desktop/package.json"]
    }
  ]
}
