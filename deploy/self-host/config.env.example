# Image/build identity
OPENSTEER_IMAGE_TAG=local
# The Docker initializer in README.md fills these from the checkout being built.
OPENSTEER_RELEASE_VERSION=replace-with-package-version
OPENSTEER_SOURCE_REVISION=replace-with-exact-git-revision

# The exact browser-visible origin. Host mutation checks compare Origin to this value.
OPENSTEER_CANONICAL_ORIGIN=https://opensteer.example.com
# HTTPS origin embedded in short-lived Runner capability plans. The private
# gateway is allowed only while OPENSTEER_ACCEPTS_EXTERNAL_RUNNERS=false.
# Accepting external Runners requires this to equal OPENSTEER_CANONICAL_ORIGIN,
# regardless of the default Workspace backing.
OPENSTEER_RUNTIME_ORIGIN=https://gateway:8443

# Images contain a verified web distribution and require production mode and HTTPS.
# For a local rehearsal, use https://localhost and accept Caddy’s local certificate.
OPENSTEER_MODE=production
# Where a Workspace goes when nobody chooses. local-directory puts it on the
# cohosted Runner's own disk; portablefs puts it in shared storage every machine
# can mount, and then requires the commented PortableFS contract below.
# Either way, a machine somebody lends this Deployment can hold Workspaces of
# its own — set OPENSTEER_ACCEPTS_EXTERNAL_RUNNERS=true and point
# OPENSTEER_RUNTIME_ORIGIN at the canonical origin to accept one.
OPENSTEER_DEFAULT_WORKSPACE_BACKING=local-directory
OPENSTEER_DEPLOYMENT_KIND=server
OPENSTEER_ACCEPTS_EXTERNAL_RUNNERS=false
# A network-reachable Deployment never mints its own first owner. Bring the
# stack up once with `-f compose.yaml -f compose.initial-owner.yaml` so Host
# reads the generated secrets/initial_owner_enrollment_token, claim ownership
# with that code, then drop the overlay again.
# The machine that holds a new Workspace when nobody names one: the cohosted
# Runner. The directories and the protected registry belong to that Runner, not
# to Host. The Docker initializer generates this once; keep it across restarts.
OPENSTEER_LOCAL_WORKSPACE_ENVIRONMENT_ID=replace-with-a-generated-environment-id
# Production hosted Chromium starts only with its sandbox and public-only proxy.
# compose.yaml sets both; do not attach browser-runtime directly to an egress network.
OPENSTEER_LOCAL_PASSWORD_ENABLED=true
# The Host's own OAuth server for signed Opensteer apps; server Deployments only.
OPENSTEER_NATIVE_OAUTH_ENABLED=true
OPENSTEER_SIGNUP_POLICY=invite-only
# OIDC is configured through an operator overlay that mounts exact provider files into Host.
# Do not put client secrets in this env file.

# PortableFS is the shared storage every machine can mount. It is what a Runner
# on another machine needs to work on this Deployment's shared Workspaces; a
# lent machine can already hold directories of its own without it. Set
# OPENSTEER_DEFAULT_WORKSPACE_BACKING above to portablefs, point
# OPENSTEER_RUNTIME_ORIGIN at the canonical origin, uncomment this contract, and
# add `-f compose.portablefs.yaml`.
# OPENSTEER_PORTABLEFS_SOURCE_DIR=/absolute/path/to/steerlabs/portablefs
# OPENSTEER_PORTABLEFS_MANAGER_URL=https://manager.portablefs.internal:8443/
# This HTTPS endpoint must be reachable from Host AND every PortableFS Runner:
# the mount daemon renews its enrollment directly, including on external machines.
# Private DNS requires private-network connectivity on each of those machines.
# OPENSTEER_PORTABLEFS_SERVICE_ID=replace-with-a-stable-portablefs-deployment-id
# OPENSTEER_PORTABLEFS_PRODUCT_ISSUER=opensteer
# OPENSTEER_PORTABLEFS_AUTHORIZATION_DOMAIN=opensteer-production
# OPENSTEER_WORKSPACE_DEFAULT_BLOCK_LIMIT_BYTES=536870912
# OPENSTEER_WORKSPACE_DEFAULT_INODE_LIMIT=50000
# OPENSTEER_PORTABLEFS_MANAGER_CA_PATH=/absolute/path/control-client-ca.pem
# OPENSTEER_PORTABLEFS_MANAGER_CERT_PATH=/absolute/path/opensteer-product.cert
# OPENSTEER_PORTABLEFS_MANAGER_KEY_PATH=/absolute/path/opensteer-product.key
# OPENSTEER_PORTABLEFS_MANAGER_SERVER_NAME=manager.portablefs.internal
# OPENSTEER_PORTABLEFS_PRODUCT_PRIVATE_KEY_PATH=/absolute/path/opensteer-product-signing.key

# PortableFS Linux Runner overlay only.
# OPENSTEER_PORTABLEFS_ARTIFACT_PATH=/absolute/path/to/pinned/portablefs
# OPENSTEER_PORTABLEFS_SHA256=replace-with-64-lowercase-hex-characters
# The PortableFS Runner overlay fixes this to the shared machine-scoped path contract.
# OPENSTEER_RUNNER_WORKSPACE_ROOT=/workspaces
OPENSTEER_MAX_CONCURRENT_RUNS=4
OPENSTEER_RUNNER_NAME=Main runner

# Required: select the Docker host policy in README.md#runner-sandbox.
OPENSTEER_RUNNER_APPARMOR_PROFILE=
