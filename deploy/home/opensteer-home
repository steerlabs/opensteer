#!/usr/bin/env bash
set -euo pipefail
default_dir=/etc/opensteer-home
if [[ -d $(dirname -- "$0") && -f $(dirname -- "$0")/images.env ]]; then default_dir=$(dirname -- "$0"); fi
home_dir=${OPENSTEER_HOME_DIR:-$default_dir}
export OPENSTEER_HOME_DIR="$home_dir"
# shellcheck source=deploy/home/common.sh
source "$home_dir/common.sh"

[[ $EUID == 0 ]] || fail "Run opensteer-home as root."
[[ -f "$home_dir/config.env" ]] || fail "No Home configuration was found at $home_dir."

# shellcheck source=deploy/home/backup.sh
source "$home_dir/backup.sh"
# shellcheck source=deploy/home/update.sh
source "$home_dir/update.sh"

recover_home() {
  restore_rollback
  update_recovery
  if [[ -f "$home_dir/backup.resume" ]]; then
    start_pod
    rm -f -- "$home_dir/backup.resume"
  fi
}

case "${1:-}" in
  status)
    [[ $# == 1 ]] || fail "Usage: opensteer-home status"
    # shellcheck source=/dev/null
    source "$home_dir/images.env"
    printf 'Version %s\n' "$OPENSTEER_HOME_VERSION"
    compose ps --all
    state=$(claimed_state) || fail "The Home's claim state is unavailable."
    if [[ $state == complete ]]; then echo 'Claimed'; else echo 'Unclaimed'; fi
    ;;
  setup-link)
    [[ $# == 1 ]] || fail "Usage: opensteer-home setup-link"
    lock_home
    [[ ! -f "$home_dir/managed" ]] || fail "The Opensteer Account issues claims for this managed Home."
    recover_home
    state=$(claimed_state) || fail "Start the Home before issuing a setup link."
    [[ $state == required ]] || fail "This Home is already claimed."
    token=$(random_secret)
    compose down
    printf '%s' "$token" | digest | save_secret "$home_dir/secrets/setup_digest"
    start_pod
    [[ $(claimed_state) == required ]] || fail "The Home was claimed before its setup link could be replaced."
    print_setup_link "$token"
    ;;
  start)
    lock_home
    recover_home
    start_pod
    ;;
  maintain)
    lock_home
    recover_home
    pid=$(host_pid) || pid=''
    if ! { [[ -n $pid && -f "$home_dir/host.pid" && $pid == "$(cat "$home_dir/host.pid")" ]] &&
      { check_firewall "$pid" || { apply_firewall "$pid" && check_firewall "$pid"; }; } &&
      compose ps --all --format json | jq -es 'length == 7 and all(.[]; .Health == "healthy")' >/dev/null; }; then
      compose down
      start_pod
    fi
    if [[ -f "$home_dir/managed" && -f "$home_dir/managed-egress.sh" ]]; then
      # shellcheck source=deploy/home/managed-egress.sh
      source "$home_dir/managed-egress.sh"
      maintain_managed_egress
    fi
    ;;
  stop)
    lock_home
    compose down
    ;;
  update|scheduled-update)
    if [[ -f "$home_dir/managed" && $# != 1 ]]; then fail 'Managed Homes update only from the Account feed.'; fi
    lock_home
    recover_home
    update_home "$@"
    ;;
  snapshots)
    backup_command "$@"
    ;;
  backup|scheduled-backup|restore)
    lock_home
    recover_home
    backup_command "$@"
    ;;
  logs)
    [[ $# == 2 ]] || fail "Usage: opensteer-home logs <service>"
    case "$2" in
      postgres|host|gateway|runner|browser-runtime|browser-egress|channel-runtime)
        compose logs --tail 200 "$2" ;;
      *) fail "Unknown Home service." ;;
    esac
    ;;
  uninstall)
    [[ $# == 1 || ( $# == 2 && $2 == --purge ) ]] || fail "Usage: opensteer-home uninstall [--purge]"
    unit=${OPENSTEER_HOME_UNIT_PREFIX:-opensteer-home}
    [[ $unit =~ ^opensteer-home(-[a-z0-9-]+)?$ ]] || fail "Invalid Home systemd unit prefix."
    system_files="/etc/systemd/system/$unit"
    if [[ -f "$system_files-managed.service" ]] &&
       grep -Fxq "ExecStart=$home_dir/boot/install.sh --resume-managed" "$system_files-managed.service"; then
      systemctl disable --now "$unit-managed.service"
    fi
    if [[ -f "$system_files.service" ]] &&
       grep -Fxq "ExecStart=$home_dir/opensteer-home start" "$system_files.service"; then
      for timer in update backup maintain; do
        if [[ -f "$system_files-$timer.timer" ]]; then
          systemctl disable --now "$unit-$timer.timer"
        fi
      done
      systemctl disable --now "$unit.service"
    fi
    lock_home
    if [[ $# == 2 ]]; then
      echo 'Removing Home configuration, database, keys, agent work, and browser profiles.'
      compose down --volumes
      remove_runner_apparmor
      if [[ -f "$system_files.service" ]] &&
         grep -Fxq "ExecStart=$home_dir/opensteer-home start" "$system_files.service"; then
        rm -f -- "$system_files"{.service,-update.service,-update.timer,-backup.service,-backup.timer,-maintain.service,-maintain.timer}
        if [[ $unit == opensteer-home ]]; then rm -f /usr/local/bin/opensteer-home; fi
      fi
      if [[ -f "$system_files-managed.service" ]] &&
         grep -Fxq "ExecStart=$home_dir/boot/install.sh --resume-managed" "$system_files-managed.service"; then
        rm -f -- "$system_files-managed.service"
      fi
      if command -v systemctl >/dev/null; then systemctl daemon-reload; fi
      rm -rf -- "${home_dir:?}/"{secrets,boot,identity,restore.pending,update.pending}
      rm -f -- "$home_dir/"{config.env,images.env,volumes.env,tls.caddy,chromium-oci.json,runner-oci.json,setup-link.pending,operation.lock,compose.yaml,compose.egress.yaml,compose.egress-pending.yaml,managed-egress.sh,egress.pending,compose.apparmor.yaml,compose.ipv6.yaml,common.sh,firewall.sh,backup.sh,update.sh,opensteer-home,install-scheduler.sh,host.pid,managed,ipv6.enabled,update-database.dump,managed-work.json,backup-ca.pem,local-images}
      rmdir -- "$home_dir" 2>/dev/null || true
    else
      compose down
      echo "Stopped. Home data and configuration are retained in Docker volumes and $home_dir."
    fi
    ;;
  *) fail "Usage: opensteer-home {status|setup-link|update|logs <service>|backup|snapshots|restore|uninstall [--purge]}" ;;
esac
