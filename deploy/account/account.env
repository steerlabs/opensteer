NODE_ENV=production
OPENSTEER_CONTROL_PLANE_PUBLIC_URL=https://accounts.opensteer.com
OPENSTEER_CONTROL_PLANE_HOST=0.0.0.0
OPENSTEER_CONTROL_PLANE_PORT=4142
OPENSTEER_CONTROL_PLANE_DATABASE_URL=postgresql://opensteer-account%40opensteer-staging.iam@127.0.0.1:5432/control_plane
OPENSTEER_CONTROL_PLANE_DATABASE_MAX_CONNECTIONS=3
OPENSTEER_CONNECT_DOMAIN=opensteerapp.com
OPENSTEER_CONNECT_CLOUDFLARE_WORKERS_ROUTE_BYPASS=on
OPENSTEER_APNS_KEY_ID=ZYG3J56USP
OPENSTEER_APNS_TEAM_ID=B47U2LLKHW
OPENSTEER_APNS_TOPIC=com.opensteer.opensteer
OPENSTEER_APPLE_SIGN_IN_CLIENT_ID=com.opensteer.account
OPENSTEER_APPLE_SIGN_IN_KEY_ID=2UYJH42N4D
OPENSTEER_APPLE_SIGN_IN_TEAM_ID=B47U2LLKHW
OPENSTEER_APP_REVIEW_EMAIL=appreview@opensteer.com
OPENSTEER_PORTAL_ORIGIN=https://app.opensteer.com
OPENSTEER_HOSTED_TEAMS_PROVISIONER_EMAIL=team-provisioner@opensteer-prod.iam.gserviceaccount.com

# Set all of these Cloud Computer inputs together to enable the service.
# OPENSTEER_CLOUD_COMPUTER_PROVISIONER_EMAIL is a separate Google service account.
# OPENSTEER_CLOUD_COMPUTER_DOMAIN is the DNS suffix for managed Home hostnames.
# OPENSTEER_CLOUD_COMPUTER_REGION and OPENSTEER_CLOUD_COMPUTER_SERVER_TYPE select Hetzner placement.
# OPENSTEER_CLOUD_COMPUTER_RELEASE_JSON has version, installerUrl, installerSha256, and images.
# images requires digest references for host, runner, browser-runtime, browser-egress,
# channel-runtime, and gateway. The installer URL serves the self-contained managed entry point.
# OPENSTEER_CLOUD_COMPUTER_PLAN_NAME, OPENSTEER_CLOUD_COMPUTER_CURRENCY, and
# OPENSTEER_CLOUD_COMPUTER_PRICE_MINOR describe the recurring Stripe price customers see.
# OPENSTEER_CLOUD_COMPUTER_STRIPE_PRICE_ID selects that recurring price in Checkout.
# Mount OPENSTEER_CLOUD_COMPUTER_STRIPE_SECRET_KEY_FILE and
# OPENSTEER_CLOUD_COMPUTER_STRIPE_WEBHOOK_SECRET_FILE as secrets.
# Register /v1/cloud-computers/stripe-webhook for checkout.session.completed,
# checkout.session.expired, invoice.payment_failed, invoice.paid,
# customer.subscription.updated, and customer.subscription.deleted.
# OPENSTEER_CLOUD_COMPUTER_BACKUP_ENDPOINT is the HTTPS S3-compatible endpoint origin.
# OPENSTEER_CLOUD_COMPUTER_BACKUP_BUCKET is the bucket containing per-Computer repositories.
# Mount OPENSTEER_CLOUD_COMPUTER_BACKUP_ACCESS_KEY_ID_FILE and
# OPENSTEER_CLOUD_COMPUTER_BACKUP_SECRET_ACCESS_KEY_FILE as secrets.
