OPENSTEER_CONNECT_CLOUDFLARE_WORKERS_ROUTE_BYPASS=on
OPENSTEER_APNS_KEY_ID=ZYG3J56USP
OPENSTEER_APNS_TEAM_ID=B47U2LLKHW
OPENSTEER_APNS_TOPIC=com.opensteer.opensteer
OPENSTEER_APPLE_SIGN_IN_CLIENT_ID=com.opensteer.account
OPENSTEER_APPLE_SIGN_IN_KEY_ID=2UYJH42N4D
OPENSTEER_APPLE_SIGN_IN_TEAM_ID=B47U2LLKHW
OPENSTEER_APP_REVIEW_EMAIL=appreview@opensteer.com
OPENSTEER_PORTAL_ORIGIN=https://app.opensteer.com

# Set all of these Cloud Computer inputs together to enable the service.
# OPENSTEER_CLOUD_COMPUTER_PROVISIONER_EMAIL is a separate Google service account.
# OPENSTEER_CLOUD_COMPUTER_DOMAIN is the DNS suffix for managed Home hostnames.
# OPENSTEER_CLOUD_COMPUTER_REGION and OPENSTEER_CLOUD_COMPUTER_SERVER_TYPE select Hetzner placement.
# OPENSTEER_CLOUD_COMPUTER_RELEASE_JSON has version, installerUrl, installerSha256, and images.
# images requires digest references for host, runner, browser-runtime, browser-egress,
# channel-runtime, and gateway. The installer URL serves the self-contained managed entry point.
# OPENSTEER_CLOUD_COMPUTER_PLAN_NAME, OPENSTEER_CLOUD_COMPUTER_CURRENCY, and
# OPENSTEER_CLOUD_COMPUTER_PRICE_MINOR describe the recurring Stripe price customers see.
# OPENSTEER_CLOUD_COMPUTER_STRIPE_PRICE_ID selects that recurring price in Checkout.
# OPENSTEER_CLOUD_COMPUTER_STRIPE_PORTAL_CONFIGURATION_ID selects the dedicated portal configuration.
# Put OPENSTEER_CLOUD_COMPUTER_STRIPE_SECRET_KEY and OPENSTEER_CLOUD_COMPUTER_STRIPE_WEBHOOK_SECRET
# in the account-runtime JSON secret. account.yaml stages these as _FILE inputs.
# OPENSTEER_CLOUD_COMPUTER_RELEASE_MANIFEST_URL optionally supplies a public HTTPS digest-pinned feed.
# OPENSTEER_CLOUD_COMPUTER_BACKUP_KEY_PROJECT selects the dedicated Secret Manager project
# for erasable backup passwords. Grant the Account workload identity access before enabling sales.
# Optional organization seat billing uses the same Stripe secrets:
# OPENSTEER_ORGANIZATION_STRIPE_PRICE_ID (separate from the personal plan),
# OPENSTEER_ORGANIZATION_STRIPE_PORTAL_CONFIGURATION_ID (payment method and invoices only),
# OPENSTEER_ORGANIZATION_CURRENCY and OPENSTEER_ORGANIZATION_PRICE_MINOR.
# OPENSTEER_ORGANIZATION_PRICE_INTERVAL defaults to month.
# Register /v1/cloud-computers/stripe-webhook for checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.expired, invoice.payment_failed, invoice.finalization_failed, invoice.paid,
# customer.subscription.pending_update_applied, customer.subscription.pending_update_expired,
# customer.subscription.updated, and customer.subscription.deleted.
# Use the operator's backup-add and backup-rotate commands to manage exclusive backup targets.
# OPENSTEER_CLOUD_COMPUTER_PRICE_INTERVAL defaults to month (one billing interval per charge).
# OPENSTEER_CLOUD_COMPUTER_IPV6 defaults to off. Enable it only with an IPv6-capable Home installer.
