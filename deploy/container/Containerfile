FROM node-runtime AS runner
USER root
RUN apt-get update && \
    apt-get install --no-install-recommends --yes fuse3 libcap2 openssh-client openssl rsync socat && \
    rm -rf /var/lib/apt/lists/* && \
    ln --force --symbolic /proc/mounts /etc/mtab && \
    test -x /usr/bin/socat && \
    test "$(readlink /etc/mtab)" = /proc/mounts && \
    if getent group fuse >/dev/null; then usermod --append --groups fuse opensteer; fi && \
    install --directory --owner root --group root --mode 0755 /opt/opensteer/control && \
    install --owner root --group root --mode 0555 \
      /usr/local/bin/opensteer-entrypoint.mjs \
      /opt/opensteer/control/opensteer-entrypoint.mjs
COPY --from=bubblewrap-build --chmod=0555 /output/bwrap /usr/local/bin/bwrap
# bubblewrap is LGPL: its licence travels with the binary.
COPY --from=bubblewrap-build --chmod=0444 /output/COPYING /usr/local/share/licenses/bubblewrap/COPYING
COPY --from=sandbox-seccomp-profiles --chmod=0444 /runner-oci.json /usr/local/share/opensteer/runner-oci.json
WORKDIR /app
ENV OPENSTEER_BROWSER_HARNESS=/app/browser-harness/browser-harness.mjs
COPY --from=runner-build --chown=10001:10001 /output/runner ./
COPY --from=package-stamps --chown=10001:10001 /output/runner/package.json ./package.json
COPY --from=runner-native-fs-build --chmod=0555 /output/opensteer-native-fs ./native-fs-helper/opensteer-native-fs
COPY --chmod=0555 apps/runner/browser-harness/browser-harness.mjs apps/runner/browser-harness/page.mjs apps/runner/browser-harness/page-functions.mjs apps/runner/browser-harness/keyboard-layout.mjs ./browser-harness/
COPY --chmod=0444 apps/runner/browser-harness/LICENSE /usr/local/share/licenses/opensteer-browser-harness/LICENSE
COPY --chmod=0444 apps/runner/browser-harness/PLAYWRIGHT-LICENSE /usr/local/share/licenses/opensteer-browser-harness/PLAYWRIGHT-LICENSE
RUN test "$(bwrap --version)" = "bubblewrap 0.11.2" && \
    test ! -u /usr/local/bin/bwrap && \
    test "$("$OPENSTEER_BROWSER_HARNESS" --version)" = "0.5.0-opensteer" && \
    node dist/verify-harness-runtimes-main.js && \
    test -x /opt/opensteer/control/opensteer-entrypoint.mjs
RUN install --directory --mode 0700 /tmp/opensteer-native-fs-probe
RUN printf '%s' '{"operation":"probe","root":"/tmp/opensteer-native-fs-probe","version":1}' | \
    ./native-fs-helper/opensteer-native-fs | \
    grep --fixed-strings '"binaryIdentity":"opensteer-native-fs"'
RUN rmdir /tmp/opensteer-native-fs-probe
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
ENV OPENSTEER_RELEASE_VERSION=${OPENSTEER_RELEASE_VERSION} \
    OPENSTEER_SOURCE_REVISION=${OPENSTEER_SOURCE_REVISION}
COPY --from=opensteer-release-record --chmod=0444 /release/release.json /usr/local/share/opensteer/release.json
USER 10001:10001
CMD ["node", "dist/main.js"]

FROM node-runtime AS browser-egress
WORKDIR /app
