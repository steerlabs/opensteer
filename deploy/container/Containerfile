# Identity generation reads only source manifests. Depending on a full build
# here would hydrate its entire cached deployment just to stamp a small JSON file.
FROM ${NODE_IMAGE} AS package-stamps
WORKDIR /source
COPY scripts/stamp-release-package.cjs ./scripts/stamp-release-package.cjs
COPY apps/host/package.json /output/host/package.json
COPY apps/control-plane/package.json /output/control-plane/package.json
COPY apps/runner/package.json /output/runner/package.json
COPY apps/browser-runtime/package.json /output/browser-runtime/package.json
COPY apps/channel-runtime/package.json /output/channel-runtime/package.json
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
ENV OPENSTEER_RELEASE_VERSION=${OPENSTEER_RELEASE_VERSION} \
    OPENSTEER_SOURCE_REVISION=${OPENSTEER_SOURCE_REVISION}
RUN node scripts/stamp-release-package.cjs /output/host/package.json && \
    node scripts/stamp-release-package.cjs /output/control-plane/package.json && \
    node scripts/stamp-release-package.cjs /output/runner/package.json && \
    node scripts/stamp-release-package.cjs /output/browser-runtime/package.json && \
    node scripts/stamp-release-package.cjs /output/channel-runtime/package.json

