# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.13.0-bookworm-slim@sha256:4660b1ca8b28d6d1906fd644abe34b2ed81d15434d26d845ef0aced307cf4b6f
ARG GO_IMAGE=golang:1.26.2-bookworm@sha256:47ce5636e9936b2c5cbf708925578ef386b4f8872aec74a67bd13a627d242b19
ARG PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble@sha256:dcc5531e97840b9b5e794f2814476b21571c5124a3fca2267d73041f56e7580e
ARG CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
ARG OPENSTEER_AGENT_PHONE_RELEASE_RECEIPT_SHA256
ARG OPENSTEER_AGENT_PHONE_MODE=none

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS agent-phone-tools
RUN apt-get update && apt-get install --no-install-recommends --yes ca-certificates curl unzip openjdk-17-jre-headless && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/android-sdk
RUN curl --fail --location --show-error --connect-timeout 10 --max-time 300 \
      https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip -o /tmp/android-tools.zip && \
    echo '7ec965280a073311c339e571cd5de778b9975026cfcbe79f2b1cdcb1e15317ee  /tmp/android-tools.zip' | sha256sum --check --strict && \
    unzip -q /tmp/android-tools.zip -d /tmp/android-tools && mkdir -p cmdline-tools && \
    mv /tmp/android-tools/cmdline-tools cmdline-tools/19.0 && rm /tmp/android-tools.zip && \
    curl --fail --location --show-error --connect-timeout 10 --max-time 300 \
      https://dl.google.com/android/repository/build-tools_r36_linux.zip -o /tmp/build-tools.zip && \
    echo '5d9ac77fb6ff43d9da518a337b4fcf8f9097113df531d99ccefe80ef7ce8250b  /tmp/build-tools.zip' | sha256sum --check --strict && \
    unzip -q /tmp/build-tools.zip -d /tmp/build-tools && mkdir -p build-tools && \
    mv /tmp/build-tools/android-16 build-tools/36.0.0 && rm /tmp/build-tools.zip

FROM ${NODE_IMAGE} AS bubblewrap-build
ARG BUBBLEWRAP_VERSION=0.11.2
ARG BUBBLEWRAP_SHA256=69abc30005d2186baf7737feacd8da35633b93cf5af38838ecff17c5f8e924f6
RUN apt-get update && \
    apt-get install --no-install-recommends --yes build-essential ca-certificates curl libcap-dev meson pkg-config xz-utils && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /source
RUN curl --connect-timeout 10 --fail --location --max-time 120 --show-error \
      --output bubblewrap.tar.xz \
      "https://github.com/containers/bubblewrap/releases/download/v${BUBBLEWRAP_VERSION}/bubblewrap-${BUBBLEWRAP_VERSION}.tar.xz" && \
    echo "${BUBBLEWRAP_SHA256}  bubblewrap.tar.xz" | sha256sum --check --strict && \
    tar --extract --file bubblewrap.tar.xz --strip-components=1 && \
    meson setup build \
      -Dbash_completion=disabled \
      -Dman=disabled \
      -Dselinux=disabled \
      -Dsupport_setuid=false \
      -Dtests=false \
      -Dzsh_completion=disabled && \
    meson compile -C build bwrap && \
    install --directory /output && \
    install --owner root --group root --mode 0555 build/bwrap /output/bwrap && \
    install --owner root --group root --mode 0444 COPYING /output/COPYING

FROM ${CADDY_IMAGE} AS caddy-capability-free
USER root
# The upstream binary carries cap_net_bind_service for ports below 1024. This
# gateway listens on 4314, so copy the binary without that unnecessary file
# capability and keep the runtime container capability-free.
RUN cp /usr/bin/caddy /caddy && chmod 0555 /caddy

FROM ${NODE_IMAGE} AS opensteer-release-record
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
WORKDIR /source
COPY package.json ./package.json
COPY scripts/release-identity.cjs scripts/release-version.cjs ./scripts/
RUN OPENSTEER_RELEASE_VERSION="${OPENSTEER_RELEASE_VERSION}" \
    OPENSTEER_SOURCE_REVISION="${OPENSTEER_SOURCE_REVISION}" \
    node -e \
    'const {mkdirSync,writeFileSync}=require("node:fs"); const {requireCanonicalReleaseIdentity}=require("./scripts/release-identity.cjs"); const identity=requireCanonicalReleaseIdentity("/source",process.env,{verifyRepository:false}); mkdirSync("/release",{recursive:true}); writeFileSync("/release/release.json",JSON.stringify({schemaVersion:1,...identity})+"\n",{mode:0o444});'

# The helper is pure Go, so compile on the builder's native architecture and
# emit the requested target binary. This keeps local Apple-silicon publication
# out of QEMU while preserving the same linux/amd64 runtime artifact as CI.
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS runner-native-fs-build
WORKDIR /source
COPY apps/runner/native-fs-helper/go.mod apps/runner/native-fs-helper/go.sum ./
RUN --mount=type=cache,id=opensteer-go-mod,target=/go/pkg/mod go mod download
COPY apps/runner/native-fs-helper/*.go ./
ARG TARGETARCH
ARG TARGETOS
RUN --mount=type=cache,id=opensteer-go-mod,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags='-s -w -buildid=' -o /output/opensteer-native-fs .

# Root version is selection metadata, not a dependency input. Give the
# normalized file fixed metadata so COPY stays identical across release stamps.
FROM ${NODE_IMAGE} AS dependency-manifests
WORKDIR /source
COPY package.json ./package.json
RUN node -e 'const fs=require("node:fs"); const manifest=JSON.parse(fs.readFileSync("package.json")); manifest.version="0.0.0"; fs.mkdirSync("/manifests"); fs.writeFileSync("/manifests/package.json",JSON.stringify(manifest)+"\n",{mode:0o644}); fs.utimesSync("/manifests/package.json",0,0);'

