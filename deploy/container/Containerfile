# Android/JRE tools are independent of all product source and phone bytes.
FROM dependencies AS phone-verification-tools
ENV ANDROID_HOME=/opt/android-sdk
RUN apt-get update && apt-get install --no-install-recommends --yes openjdk-17-jre-headless && rm -rf /var/lib/apt/lists/*
COPY --from=agent-phone-tools /opt/android-sdk/build-tools/36.0.0 /opt/android-sdk/build-tools/36.0.0

FROM phone-verification-tools AS agent-phone-verification
COPY packages ./packages
COPY scripts ./scripts
COPY apps/web/public/agent-phone ./apps/web/public/agent-phone
ARG OPENSTEER_AGENT_PHONE_RELEASE_RECEIPT_SHA256
ENV ANDROID_HOME=/opt/android-sdk \
    OPENSTEER_AGENT_PHONE_RELEASE_RECEIPT_SHA256=${OPENSTEER_AGENT_PHONE_RELEASE_RECEIPT_SHA256}
RUN OPENSTEER_RELEASE_VERSION="$(node -p "require('./apps/web/public/agent-phone/agent-phone-release.json').version")" \
    OPENSTEER_SOURCE_REVISION="$(node -p "require('./apps/web/public/agent-phone/agent-phone-release.json').sourceRevision")" \
    node scripts/release-agent-phone.cjs \
      /source/apps/web/public/agent-phone /source/apps/web/public/agent-phone/agent-phone-release.json

FROM agent-phone-verification AS web-phone-official
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
ENV OPENSTEER_RELEASE_VERSION=${OPENSTEER_RELEASE_VERSION} \
    OPENSTEER_SOURCE_REVISION=${OPENSTEER_SOURCE_REVISION}
COPY --from=web-assets /source/apps/web/dist /source/apps/web/dist
RUN OPENSTEER_RELEASE_VERSION="$(node -p "require('./apps/web/public/agent-phone/agent-phone-release.json').version")" \
    OPENSTEER_SOURCE_REVISION="$(node -p "require('./apps/web/public/agent-phone/agent-phone-release.json').sourceRevision")" \
    node scripts/release-agent-phone.cjs \
      /source/apps/web/dist/agent-phone /source/apps/web/public/agent-phone/agent-phone-release.json && \
    test -s /source/apps/web/dist/agent-phone/opensteer-agent-phone.apk

# Even a checkout containing local generated phone artifacts must omit them in
# none mode. This branch never evaluates the official APK verification stage.
FROM web-assets AS web-phone-none
RUN rm -rf /source/apps/web/dist/agent-phone

FROM web-phone-${OPENSTEER_AGENT_PHONE_MODE} AS web-build
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
ENV OPENSTEER_RELEASE_VERSION=${OPENSTEER_RELEASE_VERSION} \
    OPENSTEER_SOURCE_REVISION=${OPENSTEER_SOURCE_REVISION}
RUN node scripts/write-web-distribution-manifest.mjs \
      /source/apps/web/dist "${OPENSTEER_RELEASE_VERSION}" && \
    test -s /source/apps/web/dist/opensteer-web.json && \
    test -s /source/apps/web/dist/browser-extension.zip

FROM ${NODE_IMAGE} AS sandbox-seccomp-profiles
ARG TARGETARCH
WORKDIR /source
COPY deploy/container/chromium-seccomp.json ./chromium-seccomp.json
COPY deploy/container/compile-seccomp-profile.mjs ./compile-seccomp-profile.mjs
RUN node ./compile-seccomp-profile.mjs \
      ./chromium-seccomp.json /chromium-oci.json "${TARGETARCH}" CAP_SYS_CHROOT && \
    node ./compile-seccomp-profile.mjs \
      ./chromium-seccomp.json /runner-oci.json "${TARGETARCH}" CAP_DAC_READ_SEARCH CAP_SYS_ADMIN

FROM ${NODE_IMAGE} AS node-runtime
COPY --chmod=0444 THIRD_PARTY_NOTICES.md /usr/local/share/licenses/opensteer/THIRD_PARTY_NOTICES.md
ENV NODE_ENV=production \
    OPENSTEER_RELEASE_RECORD=/usr/local/share/opensteer/release.json
RUN apt-get update && \
    apt-get install --no-install-recommends --yes ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 opensteer && \
    useradd --create-home --gid 10001 --shell /usr/sbin/nologin --uid 10001 opensteer && \
    install --directory --owner 10001 --group 10001 --mode 0700 /var/lib/opensteer && \
    install --directory --owner 10001 --group 10001 --mode 0700 /var/lib/opensteer-public && \
    install --directory --owner 10001 --group 10001 --mode 0700 /workspaces && \
    install --directory --owner root --group root --mode 0755 /usr/local/share/opensteer
COPY --chmod=0555 deploy/container/opensteer-entrypoint.mjs /usr/local/bin/opensteer-entrypoint.mjs
ENTRYPOINT ["tini", "--", "node", "/usr/local/bin/opensteer-entrypoint.mjs"]

