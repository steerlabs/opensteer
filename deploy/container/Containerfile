FROM ${PLAYWRIGHT_IMAGE} AS browser-runtime-base
ENV NODE_ENV=production \
    OPENSTEER_RELEASE_RECORD=/usr/local/share/opensteer/release.json
RUN groupadd --gid 10001 opensteer && \
    useradd --create-home --gid 10001 --shell /usr/sbin/nologin --uid 10001 opensteer && \
    install --directory --owner 10001 --group 10001 --mode 0700 /var/lib/opensteer/browser && \
    install --directory --owner root --group root --mode 0755 /usr/local/share/opensteer
WORKDIR /app
COPY --from=browser-runtime-build --chown=10001:10001 /output/browser-runtime ./
COPY --chmod=0555 deploy/container/opensteer-entrypoint.mjs /usr/local/bin/opensteer-entrypoint.mjs
# The host container supervisor extracts this exact profile before starting the
# Runtime. Keeping the policy with the image prevents deployment drift between
# the Chromium build and the syscalls its sandbox is allowed to use.
COPY --chmod=0444 deploy/container/chromium-seccomp.json /usr/local/share/opensteer/chromium-seccomp.json
COPY --from=sandbox-seccomp-profiles --chmod=0444 /chromium-oci.json /usr/local/share/opensteer/chromium-oci.json
COPY --from=sandbox-seccomp-profiles --chmod=0444 /runner-oci.json /usr/local/share/opensteer/runner-oci.json
USER 10001:10001
EXPOSE 4312
ENTRYPOINT ["node", "/usr/local/bin/opensteer-entrypoint.mjs"]
CMD ["node", "dist/main.js"]

FROM browser-runtime-base AS browser-runtime
COPY --from=package-stamps --chown=10001:10001 /output/browser-runtime/package.json ./package.json
ARG OPENSTEER_RELEASE_VERSION
ARG OPENSTEER_SOURCE_REVISION
ENV OPENSTEER_RELEASE_VERSION=${OPENSTEER_RELEASE_VERSION} \
    OPENSTEER_SOURCE_REVISION=${OPENSTEER_SOURCE_REVISION}
COPY --from=opensteer-release-record --chmod=0444 /release/release.json /usr/local/share/opensteer/release.json

FROM ${CADDY_IMAGE} AS gateway
COPY deploy/gateway/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /source/apps/web/dist /srv/opensteer-web
COPY --from=opensteer-release-record --chmod=0755 /release/release.json /usr/local/share/opensteer/release.json
COPY --from=opensteer-release-record --chmod=0444 /release/release.json /usr/local/share/opensteer/release.json
ENV OPENSTEER_RELEASE_RECORD=/usr/local/share/opensteer/release.json
EXPOSE 80 443
