        "name",
      ],
      "type": "object",
    },
    "name": "computer_update",
  },
  {
    "access": "settings",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Remove a computer or phone from Opensteer, or end one of its access sessions. Removing a computer revokes it, ending its sessions and deleting its browser profiles; iPhones it drives stay listed as not connected. Removing a Mac-driven iPhone removes only that iPhone and its approvals; its Mac stays. Adding either back needs the person.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "anyOf": [
            {
              "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
            {
              "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
          ],
          "description": "computer: the computer or phone to remove.",
        },
        "sessionId": {
          "description": "session: a session ID from computer_list.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "target": {
          "enum": [
            "computer",
            "session",
          ],
          "type": "string",
        },
      },
      "required": [
        "target",
      ],
      "type": "object",
    },
    "name": "computer_remove",
  },
  {
    "access": "write",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Run JavaScript to operate approved Mac windows and phone screens (Android Agent Phones and Mac-driven iPhones); variables and handles last for this Run attempt. tab(tabId), using an ID from tab_list or tab_open, binds that exact window or phone. apps() and phones() list visible targets with either access (read/read-write) or blocked {code,message,next}; app(query) and phone(query) match name, id or computerId and throw that blocked error when access is missing. Bound handles report tabId. Observe before using screenshot coordinates or element indices. Await calls and print() results; execution has a 100 second deadline. Read opensteer:computer-use for the window and phone API. After an outcome-unknown action, observe before repeating it. Connected agents: name one app or phone screen shared with you by computerId and app (omit app for a phone screen); the script reaches only that one, and tab() is not available. Use at most 20,000 characters. Set readOnly: true to observe without approval.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "app": {
          "description": "Connected agents only: the Mac app's name or bundleId; omit for a phone screen.",
          "maxLength": 240,
          "minLength": 1,
          "type": "string",
        },
        "code": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "computerId": {
          "anyOf": [
            {
              "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
            {
              "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
          ],
          "description": "Connected agents only: the Mac or phone from computer_apps.",
        },
        "operationId": {
          "description": "Connected agents only: continue the same call with this ID and the same arguments.",
          "pattern": "^aop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "operationKey": {
          "description": "Connected agents only: the key for retrying this call.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "readOnly": {
          "description": "Connected agents only: allow observation, with no input or other changes.",
          "type": "boolean",
        },
        "reason": {
          "description": "Connected agents only: why, shown to the person reviewing.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "taskId": {
          "description": "Connected agents only: taskId from an earlier result.",
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
      },
      "required": [
        "code",
      ],
      "type": "object",
    },
    "name": "computer_use",
  },
  {
    "access": "read",
    "callers": [
      "run",
      "program",
      "connection",
    ],
    "description": "List Macs set up for computer use and phone screens (Android Agent Phones and Mac-driven iPhones). Each visible app or phone has access (read/read-write) or blocked {code,message,next}; follow its next step. A computer can also carry its own blocker. Pass a computerId to list that Mac's or phone's installed apps, filtered by query; phone apps include the opaque appId that launch takes. Listing grants no access; ask with app_access_request.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "anyOf": [
            {
              "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
            {
              "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
          ],
          "description": "computerId from this listing or computer_list; omit to list Macs and phone screens.",
        },
        "cursor": {
          "description": "nextCursor from the previous page.",
          "pattern": "^\\d{1,5}$",
          "type": "string",
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "default": "",
          "description": "Filters a computer's installed apps.",
          "maxLength": 240,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "computer_apps",
  },
  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Ask the person to turn on access to one of their computers: browser, apps or files when a refusal or computer_list shows that switch off, or macOS Full Disk Access when authorized SSH work needs protected files and the other-computers note says it is off. Never ask for an offline computer, and never ask again after Not now in this task. Access granted later resumes in a new Run; app, profile and system permissions still apply.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "browser",
            "apps",
            "files",
            "full_disk_access",
          ],
          "type": "string",
        },
        "computerId": {
          "anyOf": [
            {
              "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
            {
              "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
          ],
          "description": "Computer or phone from the refusal or computer_list.",
        },
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Why this task needs that access.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "computerId",
        "access",
        "reason",
      ],
      "type": "object",
    },
    "name": "computer_access_request",
  },
  {
    "access": "write",
    "callers": [
      "run",
      "program",
    ],
    "description": "Ask the person for access. For a device data app on a Mac or iPhone pass dataApp and its computerId, when known. For a local server pass server. A Trigger occurrence can ask for either and returns pending without a continuation. Only a running task can ask for computer_use access: pass app for one Mac app and its computerId unless the task runs there, or only computerId for a whole phone screen. A Mac-driven iPhone screen needs its own approval. read observes and read-write also acts. Pending grants no access. Never repeat a pending or declined ask.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "read",
            "read-write",
          ],
          "type": "string",
        },
        "app": {
          "description": "Mac app name, path or bundle ID, operated through computer_use.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "computerId": {
          "anyOf": [
            {
              "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
            {
              "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
            },
          ],
          "description": "computerId from computer_apps or computer_list. Omit for a Mac app on this task’s computer; for dataApp, the person chooses its computer if it has no connection yet. Omit for server.",
        },
        "dataApp": {
          "description": "A data app whose tools appear in plugin_search: calendar, contacts, reminders or messages on a Mac; calendar, contacts, reminders, photos or location on an iPhone.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string",
        },
        "server": {
          "description": "A local server's name from local_server_list.",
          "maxLength": 64,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "access",
        "reason",
      ],
      "type": "object",
    },
    "name": "app_access_request",
  },
  {
    "access": "write",
    "callers": [
      "connection",
    ],
    "description": "Run a browser script in a granted profile or a Chrome tab the person shared. For a shared Chrome tab, pass its tabId from tab_list. You can follow its popups and access the signed-in sites and cookies available to that tab. Creating or closing tabs and changing browser-wide settings require a separate browser context. await pages() finds your tabs and await openPage(tabId) binds one; await newPage(url, { profileId }) opens one, with the profileId this tool reports or browser_profile_list gives. Pages have goto, getByRole, locator, js(expression), cdp(method, params) and screenshot(), which captures the viewport without resizing the person's view. Await every browser call; print(...) or return text; keep handles on globalThis to reuse them in later calls of this task. The profile's signed-in state is shared with you. Saved passwords and cards need the person's approval through saved_login_request and card_request. If an outcome is uncertain, look at the page before repeating anything.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "operationId": {
          "description": "Connected agents only: continue the same call with this ID and the same arguments.",
          "pattern": "^aop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "operationKey": {
          "description": "Connected agents only: the key for retrying this call.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "profileId": {
          "description": "A browser profile shared with you, when you hold several and name no tab.",
          "pattern": "^bpr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "reason": {
          "description": "Connected agents only: why, shown to the person reviewing.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "tabId": {
          "description": "A tab from tab_list, including a Chrome tab marked sharedByPerson.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
        },
        "taskId": {
          "description": "Connected agents only: taskId from an earlier result.",
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
      },
      "required": [
        "code",
      ],
      "type": "object",
    },
    "name": "browser_use",
  },
  {
    "access": "write",
    "callers": [
      "connection",
    ],
    "description": "Get a WebSocket endpoint for chromium.connectOverCDP() for a granted profile or a Chrome tab the person shared. For a saved profile, control your task's own pages and access every cookie and signed-in site in the profile for up to 10 minutes. For shared Chrome, pass its tabId from tab_list. Control extends to the tab and its popups, including the signed-in sites and cookies accessible there. Connect within a minute; the connection ends when the time runs out or the person stops the task or disconnects you. Use the returned connect line exactly.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "Connected agents only: continue the same call with this ID and the same arguments.",
          "pattern": "^aop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "operationKey": {
          "description": "Connected agents only: the key for retrying this call.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "profileId": {
          "description": "A browser profile shared with you, when you hold several and name no tab.",
          "pattern": "^bpr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "reason": {
          "description": "Connected agents only: why, shown to the person reviewing.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "tabId": {
          "description": "A tab from tab_list, including a Chrome tab marked sharedByPerson.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
        },
        "taskId": {
          "description": "Connected agents only: taskId from an earlier result.",
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
      },
      "type": "object",
