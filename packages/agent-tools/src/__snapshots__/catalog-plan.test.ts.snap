                      "type": "string",
                    },
                    "maxItems": 100,
                    "type": "array",
                  },
                  "propertyNames": {
                    "maxLength": 512,
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": "object",
                },
                "kind": {
                  "const": "form",
                  "type": "string",
                },
              },
              "required": [
                "answers",
                "kind",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "external",
                  "type": "string",
                },
                "value": {
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema0",
                  },
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
              },
              "required": [
                "kind",
              ],
              "type": "object",
            },
          ],
        },
      },
