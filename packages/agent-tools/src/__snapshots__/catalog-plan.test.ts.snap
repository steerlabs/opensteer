            {
              "type": "number",
            },
            {
              "type": "boolean",
            },
            {
              "type": "null",
            },
            {
              "items": {
                "$ref": "#/$defs/__schema0",
              },
              "type": "array",
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/__schema0",
              },
              "propertyNames": {
                "type": "string",
              },
