    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "aiAccountId": {
          "description": "New task AI account from opensteer_ai_account_list.",
          "pattern": "^hin_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "message": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "mode": {
          "default": "async",
          "enum": [
            "async",
            "wait",
          ],
          "type": "string",
        },
        "model": {
          "additionalProperties": false,
          "description": "New task model selectors/options from opensteer_ai_account_list.",
          "properties": {
            "modelId": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string",
            },
            "options": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "maxLength": 255,
                    "type": "string",
                  },
                  {
                    "type": "number",
                  },
                  {
                    "type": "boolean",
                  },
                ],
              },
              "default": {},
              "propertyNames": {
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "type": "string",
              },
              "type": "object",
            },
            "providerId": {
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string",
            },
          },
          "required": [
            "modelId",
            "providerId",
          ],
          "type": "object",
        },
        "observationId": {
          "description": "Watch observation identity; reuse for the same observation.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "specialist": {
          "description": "Ready specialist registration ID or plugin name.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "timeoutMs": {
          "default": 50000,
          "maximum": 100000,
          "minimum": 1,
          "type": "integer",
        },
        "title": {
          "description": "New task: 2–5 words naming the outcome; defaults to the first task line.",
          "maxLength": 240,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "message",
      ],
      "type": "object",
    },
