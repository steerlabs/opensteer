  {
    "access": "read",
    "callers": [
      "run",
      "program",
      "connection",
    ],
    "description": "List the person's browser profiles and the sites whose Chrome cookies they let Opensteer copy. Each profile opens only on its home computer; if that computer is offline, name it and stop, never substitute another profile. A profile's name never proves a login. Ask with browser_profile_request only when none fits.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
