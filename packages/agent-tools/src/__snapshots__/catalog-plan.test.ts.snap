          "description": "App ID from app_list or app_publish.",
          "pattern": "^app_[0-9a-f-]{36}$",
          "type": "string",
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string",
        },
        "path": {
          "description": "HTML file or server folder relative to Agent home, without traversal.",
          "maxLength": 4096,
          "minLength": 1,
          "type": "string",
        },
        "start": {
          "description": "Hosting-computer shell command; the server reads PORT from its environment.",
          "maxLength": 16384,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "path",
        "name",
      ],
      "type": "object",
    },
