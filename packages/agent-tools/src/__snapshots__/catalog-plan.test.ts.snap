          "pattern": "^app_[0-9a-f-]{36}$",
          "type": "string",
        },
      },
      "required": [
        "appId",
      ],
      "type": "object",
    },
    "name": "app_delete",
  },
  {
    "access": "read",
    "callers": [
      "run",
      "program",
      "connection",
    ],
    "description": "List the computers and phones you can see, including whether each is online, what it can do and which access switches are on. A phone with screen control has phoneDisplay, with availability, navigation buttons, actions and setup. An iPhone names its connected Mac only if you can see that Mac. Only computers that host work can run tasks or open shells. Listing a computer does not grant access.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "nextCursor from the previous page.",
