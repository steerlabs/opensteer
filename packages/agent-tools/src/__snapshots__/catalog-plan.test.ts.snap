              "maxLength": 4096,
              "minLength": 1,
              "type": "string",
            },
          },
          "required": [
            "computerId",
            "path",
          ],
          "type": "object",
        },
        "harnessInstanceId": {
          "description": "New task engine account from orchestrator_capabilities.",
          "pattern": "^hin_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "mode": {
          "default": "async",
          "enum": [
            "async",
            "wait",
          ],
          "type": "string",
        },
        "model": {
          "additionalProperties": false,
          "description": "New task model selectors/options from orchestrator_capabilities.",
          "properties": {
            "modelId": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string",
            },
            "options": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "maxLength": 255,
                    "type": "string",
                  },
                  {
                    "type": "number",
                  },
                  {
                    "type": "boolean",
                  },
                ],
              },
              "default": {},
              "propertyNames": {
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "type": "string",
              },
              "type": "object",
            },
            "providerId": {
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string",
            },
          },
          "required": [
            "modelId",
            "providerId",
          ],
          "type": "object",
        },
        "observationId": {
          "description": "Watch observation identity; reuse for the same observation.",
          "maxLength": 255,
          "minLength": 1,
          "type": "string",
        },
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "places": {
          "description": "Authorized page/app/phone content to forward; text IDs alone do not attach it.",
          "items": {
            "oneOf": [
              {
                "properties": {
                  "auto": {
                    "type": "boolean",
                  },
                  "documentId": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string",
                  },
                  "sessionId": {
                    "pattern": "^bsn_[0-9a-f-]{36}$",
                    "type": "string",
                  },
                  "tabId": {
                    "maxLength": 512,
                    "minLength": 1,
                    "type": "string",
                  },
                  "title": {
                    "maxLength": 256,
                    "type": "string",
                  },
                  "type": {
                    "const": "browser-page",
                    "type": "string",
                  },
                  "url": {
                    "maxLength": 2048,
                    "type": "string",
                  },
                },
                "required": [
                  "type",
                  "sessionId",
                  "tabId",
                  "title",
                  "url",
                ],
                "type": "object",
              },
              {
                "properties": {
                  "app": {
                    "properties": {
                      "bundleId": {
                        "maxLength": 255,
                        "minLength": 1,
                        "type": "string",
                      },
                      "displayName": {
                        "maxLength": 255,
                        "minLength": 1,
                        "type": "string",
                      },
                      "teamId": {
                        "anyOf": [
