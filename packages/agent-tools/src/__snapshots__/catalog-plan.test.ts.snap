          "type": "string",
        },
      },
      "required": [
        "profileId",
        "name",
      ],
      "type": "object",
    },
    "name": "browser_profile_update",
  },
  {
    "access": "settings",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Delete a browser profile, clear its history, remove one history URL, or forget a remembered site so its cookies are no longer copied. New profiles, sign-in and pairing need the person.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "description": "profile, history and history_url: the profile.",
          "pattern": "^bpr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
