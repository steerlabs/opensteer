    ],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "folder": {
          "additionalProperties": false,
          "description": "New task folder on the hosting computer; omit when reusing threadId.",
          "properties": {
            "computerId": {
              "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
