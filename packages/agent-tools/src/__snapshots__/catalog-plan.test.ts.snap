          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "default": 20,
          "description": "Max items.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "maxCharsPerItem": {
          "default": 20000,
          "description": "Max characters per item.",
          "maximum": 50000,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Search message text.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "runLimit": {
          "default": 10,
          "description": "Max recent Runs.",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
        "taskId": {
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "textOffset": {
          "description": "nextTextOffset of a cut-off item, with its itemId.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "view": {
          "default": "messages",
          "enum": [
            "messages",
            "activity",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "opensteer_task_read",
  },
  {
    "access": "read",
