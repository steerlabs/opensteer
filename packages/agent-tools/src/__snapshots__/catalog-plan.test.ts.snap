          "description": "Ready specialist registration ID or plugin name.",
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "task": {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string",
        },
        "threadId": {
          "description": "Finished task to continue; omit new-task selectors.",
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "timeoutMs": {
          "default": 50000,
          "maximum": 100000,
          "minimum": 1,
          "type": "integer",
        },
        "title": {
