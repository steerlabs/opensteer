    "name": "app_list",
  },
  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Start the server app from app_list on its saved computer and fixed port. It keeps running after this Run and restarts when that computer reconnects. Requires a full-access Run. Opening or viewing a stopped app does not start it.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "appId": {
