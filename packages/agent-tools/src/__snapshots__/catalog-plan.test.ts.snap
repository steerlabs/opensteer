      "type": "object",
    },
    "name": "browser_profile_remove",
  },
  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Ask the person for a browser profile when none in browser_profile_list fits: they want a new one, or the work needs a separate identity. Never for an already available profile (open it), and not merely because work is signed-out: a profile still browses signed-out sites with a normal, aged identity, while a Guest tab is a brand-new browser that sites challenge more. Only the person creates or grants profiles. Suggest an existing profileId, or a new name of one or two plain words such as Brex, Work or Finance; the person may choose differently. When the Request is fulfilled, open the profile it names; pending gives no profile.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Why this task needs the profile.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "suggestion": {
          "description": "Suggestion only: existing profile, new empty profile, or user_choice. The person decides.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "existing",
                  "type": "string",
                },
                "profileId": {
                  "description": "Existing owner profile to suggest; the person decides.",
                  "pattern": "^bpr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string",
                },
              },
              "required": [
                "kind",
                "profileId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "new",
                  "type": "string",
                },
                "suggestedName": {
                  "description": "One or two plain words, such as Personal, Work or Finance.",
                  "maxLength": 120,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "kind",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "user_choice",
                  "type": "string",
                },
              },
              "required": [
                "kind",
              ],
              "type": "object",
            },
          ],
        },
      },
      "required": [
        "reason",
        "suggestion",
      ],
      "type": "object",
    },
    "name": "browser_profile_request",
  },
  {
    "access": "write",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Sign in with a login and password saved in Opensteer Passwords, with the person's approval. When loginRef is returned, fill without seeing the values: in a browser, focus each field and call fillLogin(loginRef, "username" | "password" | "code"); in a genuine Mac or phone app, type {loginRef, field}. Then submit and check the account. The reference lasts about an hour, so call again to sign back in after a site logs you out. When Passwords lacks the login, is not set up or is off, Opensteer shows the person how to fix it under your reply and tells you once a login is saved; that status is true only when returned, so if the person says it is fixed or asks again, call again first. For a connected agent, pass taskId and a tab in a shared profile, then call page.cdp with Opensteer.fillLogin and {loginRef, field} in that tab.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "Connected agents only: continue the same call with this ID and the same arguments.",
          "pattern": "^aop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Why this task needs the account.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "site": {
          "description": "Site whose login is needed, such as github.com. Covers its subdomains.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string",
        },
        "tabId": {
          "description": "Browser tab showing the site's sign-in form; omit for a genuine app.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
        },
        "taskId": {
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
      },
      "required": [
        "reason",
        "site",
      ],
      "type": "object",
    },
    "name": "saved_login_request",
  },
  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Sign in by copying the person's Chrome cookies for a site into a browser tab, with their approval. No typing or codes, but some sites (often banks) tie a login to the original browser and refuse copied cookies; saved_login_request signs in fresh instead. When cookiesStatus is "copied", reload and check the account. Fulfilled alone does not mean cookies arrived. You never see cookie values.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Why this task needs the account.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "site": {
          "description": "Site whose login is needed, such as github.com. Covers its subdomains.",
          "maxLength": 2048,
          "minLength": 1,
          "type": "string",
        },
        "tabId": {
          "description": "Browser tab to receive the cookies.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "reason",
        "tabId",
        "site",
      ],
      "type": "object",
    },
    "name": "chrome_cookies_request",
  },
  {
    "access": "write",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Ask the person to approve a saved card for this checkout site, in the hosting computer's browser only. When cardRef is returned, focus each field and call fillCard(cardRef, field); values never appear in results. Never read back, print, log, copy or save card values. Approval covers filling, not permission to buy: the person's request must cover the purchase. For a connected agent, pass taskId and a tab in a shared profile. In browser_use, call page.cdp with Opensteer.fillCard and {cardRef, field}.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "Connected agents only: continue the same call with this ID and the same arguments.",
          "pattern": "^aop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "operationKey": {
          "description": "Retry key for identical input; usually omit.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "site": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string",
        },
        "tabId": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
        },
        "taskId": {
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
      },
      "required": [
        "site",
        "reason",
        "tabId",
      ],
      "type": "object",
    },
    "name": "card_request",
  },
  {
    "access": "read",
    "callers": [
      "run",
      "program",
      "connection",
    ],
    "description": "Find plugin tools by words in their paths, descriptions and labels. Returns exact paths, one-line descriptions and input types, with plugins and linked accounts listed once. Pass a path to plugin_call or plugin_describe, or use tools.<plugin>.<tool>() in plugin_execute. Omit query to list a namespace. Read the following page by passing next as the whole input; null ends paging. Approved device data apps (Calendar, Contacts, Reminders, Messages, iPhone Location and Photos) and local servers are plugins too, with stable namespaces returned by discovery; blocked namespaces and tool items carry code, message and next; follow the target's next step. Read tools remain usable when a write needs more access. A task's ceiling and the person's access are separate. Only the person can change Read-only or Off in Plugins.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "At most 100. Page with next.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "namespace": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "offset": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "query": {
          "maxLength": 2000,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "plugin_search",
  },
  {
    "access": "read",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Find plugins available to install by service name or purpose. Returns catalog ids, names, one-line descriptions and required account methods. Pass cursor to continue; null ends paging. Use the returned id with opensteer_plugin_install; installation never links an account.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "maximum": 30,
          "minimum": 1,
          "type": "integer",
        },
        "search": {
          "maxLength": 2000,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "opensteer_plugin_catalog",
  },
  {
    "access": "read",
    "callers": [
      "run",
      "program",
      "connection",
    ],
    "description": "List live plugin skills with {} or {app:namespace}; read one with {app,name}, and a referenced file with {app,name,file}. Use the namespace from plugin_search or opensteer_plugin_list. These skills may depend on linked accounts; a read never links one. Native packaged skills remain available without starting the plugin engine.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "app": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "file": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "revision": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "plugin_skills",
  },
  {
    "access": "read",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Read a plugin's schedules and runs, workflow declarations and runs (newest first, even if current declarations fail), or webhook subscriptions. The first page carries schedule/workflow definitions with names and input schemas for configuration and starting; null means current definitions could not be evaluated, while durable runs remain readable. Pass the returned next cursor for older runs. Run outputs are shown only to your own tasks while the plugin is on; otherwise a run shows what ran, when and how it ended. These reads do not start work or reveal webhook setup secrets. Scheduled approval answers and manual webhook setup/cleanup confirmation belong to the person in Plugins.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 512,
          "type": "string",
