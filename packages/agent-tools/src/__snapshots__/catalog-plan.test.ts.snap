  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Remove these entries from the person's tab list. This does not quit a desktop app, stop a phone, stop agent work or stop an app server. Each ID is independent; closed lists successes and failed gives per-tab errors. Use app_stop to stop an app server.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "description": "Connected agents only: continue the same call with this ID and the same arguments.",
          "pattern": "^aop_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "operationKey": {
          "description": "Connected agents only: the key for retrying this call.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        "reason": {
          "description": "Connected agents only: why, shown to the person reviewing.",
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
        "tabIds": {
          "description": "Tab ID(s) from tab_list, tab_open, or a bound computer_use handle.",
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array",
        },
        "taskId": {
          "description": "Connected agents only: taskId from an earlier result.",
          "pattern": "^thr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
      },
      "required": [
        "tabIds",
      ],
      "type": "object",
    },
    "name": "tab_close",
  },
  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Move tabs into an existing group, a new named group, or no group (null). All kinds can mix. tabIds gives their order. beforeTabId inserts before a destination tab; omit it to append. To move a whole group, pass all of its tabIds with its groupId; beforeTabId then places the group before that tab. Get IDs from tab_list. A stale destination fails without moving anything.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "beforeTabId": {
          "description": "Tab ID from tab_list. Inside a group, inserts before that member. At root, a group’s first member anchors its top-level boundary. Whole-group moves use an outside anchor; omit it to append the block. Empty groups cannot be anchors.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string",
        },
        "group": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "groupId": {
                  "description": "Group ID from tab_list.groups.",
                  "pattern": "^tgp_[0-9a-f-]{36}$",
                  "type": "string",
                },
              },
              "required": [
                "groupId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "color": {
                  "enum": [
                    "grey",
                    "blue",
                    "red",
                    "yellow",
                    "green",
                    "pink",
                    "purple",
                    "cyan",
                    "orange",
                  ],
                  "type": "string",
                },
                "name": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "name",
                "color",
              ],
              "type": "object",
            },
            {
              "type": "null",
            },
          ],
        },
        "tabIds": {
          "description": "Tab ID(s) from tab_list, tab_open, or a bound computer_use handle.",
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 500,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "tabIds",
        "group",
      ],
      "type": "object",
    },
    "name": "tab_organize",
  },
  {
    "access": "write",
    "callers": [
      "run",
