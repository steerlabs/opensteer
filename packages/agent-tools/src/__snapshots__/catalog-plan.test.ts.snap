          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "computer_list",
  },
  {
    "access": "settings",
    "callers": [
      "run",
      "connection",
    ],
    "description": "Rename one of the person's computers. Enrollment, pairing and access switches need the person.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "anyOf": [
            {
              "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string",
