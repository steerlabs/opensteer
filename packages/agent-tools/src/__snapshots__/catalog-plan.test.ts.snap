  {
    "access": "write",
    "callers": [
      "run",
      "program",
      "connection",
    ],
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "automationId": {
          "pattern": "^trg_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "expectedRevisionId": {
          "pattern": "^trv_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string",
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string",
        },
        "program": {
          "additionalProperties": false,
          "properties": {
            "language": {
              "enum": [
                "javascript",
                "typescript",
              ],
              "type": "string",
            },
            "source": {
              "maxLength": 524288,
              "minLength": 1,
              "type": "string",
            },
            "toolContractVersion": {
              "const": 4,
              "type": "number",
            },
          },
          "required": [
            "language",
            "source",
            "toolContractVersion",
          ],
          "type": "object",
        },
        "source": {
          "additionalProperties": false,
          "description": "Automation source. kind "schedule" requires exactly one of at (a one-shot UTC ISO-8601 instant) or cron (a recurring expression), and cron additionally requires timezone as an IANA name; payload is the constant event payload each occurrence receives. kind "webhook" and kind "watch" accept none of at, cron, timezone, or payload.",
          "properties": {
            "at": {
              "format": "date-time",
