                },
                "schedule": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string",
                },
                "scheduleId": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "action",
                "schedule",
                "scheduleId",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "workflow.start",
                  "type": "string",
                },
                "input": {
                  "$ref": "#/$defs/__schema0",
                },
                "key": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string",
                },
                "workflow": {
