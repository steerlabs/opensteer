          "type": "string",
        },
      },
      "required": [
        "appId",
      ],
      "type": "object",
    },
    "name": "app_stop",
  },
  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Stop this app's server, close its tabs, revoke its viewing access and remove its publications. Its folder and data stay on disk. Get appId from app_list or app_publish. Deleting the origin chat does not delete an app.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
