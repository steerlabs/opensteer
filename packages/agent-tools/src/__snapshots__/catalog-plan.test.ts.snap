  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Stop the server app from app_list and keep it stopped across reconnects. Its folder and tabs remain. An offline computer records the stopped intent; it cannot start the app on reconnect. Use app_start to run it again.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
