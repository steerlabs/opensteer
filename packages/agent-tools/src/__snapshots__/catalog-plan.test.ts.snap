  {
    "access": "write",
    "callers": [
      "run",
    ],
    "description": "Publish a UTF-8 HTML file or a server folder in Agent home. name labels its cards and Apps entry. Supply appId from app_list or an earlier publication to update it. With start, a full-access Run starts and verifies the server before publishing; the server listens on 127.0.0.1 at PORT. Its port stays fixed. Publishing HTML there stops its server. Publication adds a chat card, not a tab; tab_open with kind app opens one.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
