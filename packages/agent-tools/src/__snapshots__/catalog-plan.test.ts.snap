                            "pattern": "^[A-Z0-9]{10}$",
                            "type": "string",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                    },
                    "required": [
                      "bundleId",
                      "displayName",
                      "teamId",
                    ],
                    "type": "object",
                  },
                  "auto": {
                    "const": false,
                    "type": "boolean",
                  },
                  "machineId": {
                    "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string",
                  },
                  "name": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": {
                    "const": "computer-app",
                    "type": "string",
                  },
                },
                "required": [
                  "type",
                  "machineId",
                  "app",
                  "name",
                ],
                "type": "object",
              },
              {
                "properties": {
                  "auto": {
                    "const": false,
                    "type": "boolean",
                  },
                  "display": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string",
                  },
                  "machineId": {
                    "pattern": "^rnr_[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "type": "string",
                  },
                  "name": {
                    "maxLength": 255,
                    "minLength": 1,
                    "type": "string",
                  },
                  "type": {
