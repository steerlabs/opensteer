            "webhooks",
          ],
          "type": "string",
        },
      },
      "required": [
        "pluginId",
        "resource",
      ],
      "type": "object",
    },
    "name": "plugin_resources",
  },
  {
    "access": "settings",
    "callers": [
      "run",
    ],
    "description": "Configure a declared schedule, run it now, start or stop a workflow, or remove a webhook subscription. Read plugin_resources first for current identities; cursor paging keeps every live workflow reachable. Starting a workflow needs a unique key: reusing that key recovers the same start. Manual provider cleanup and its confirmation, scheduled approval settings and answers, webhook secret setup and account links remain person-only.",
    "input": {
      "$defs": {
        "__schema0": {
          "anyOf": [
            {
              "type": "string",
