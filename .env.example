OPENSTEER_MODE=development
OPENSTEER_DEFAULT_WORKSPACE_BACKING=local-directory
OPENSTEER_DEPLOYMENT_KIND=server
OPENSTEER_WEB_PORT=43100
OPENSTEER_DATABASE_URL=postgres://opensteer:opensteer@127.0.0.1:54329/opensteer
# Integration runs own disposable PostgreSQL containers on free loopback ports.
# To use caller-owned servers, set both test database URLs (see docs/testing.md).
OPENSTEER_AUTH_SECRET=replace-with-at-least-32-random-characters
OPENSTEER_LOCAL_PASSWORD_ENABLED=true
# The Host's own OAuth server for signed Opensteer apps; server Deployments only.
OPENSTEER_NATIVE_OAUTH_ENABLED=true
OPENSTEER_SIGNUP_POLICY=invite-only
# Optional operator-owned JSON array. Each provider points at a separate client-secret file.
# OPENSTEER_OIDC_CONFIG_PATH=/absolute/path/oidc-providers.json
# A Host whose public origin and listener are both loopback declares the
# loopback development Host: it mints its own first-owner code, opens the
# browser on a setup link carrying it, and enrolls its own co-located Main
# Runner. OPENSTEER_INITIAL_OWNER_ENROLLMENT_TOKEN belongs to the enrollment
# axis instead and is refused here.
# Set to false to keep `pnpm dev` from opening a browser.
# OPENSTEER_OPEN_BROWSER=false
# Vite is the browser-visible origin and proxies /v1 to the Host.
OPENSTEER_CANONICAL_ORIGIN=http://localhost:43100
# Optional private Host route for Runner/MCP/mount callbacks, allowed only while
# this Deployment does not accept Runners from outside its own network. Defaults
# to the canonical origin.
# OPENSTEER_RUNTIME_ORIGIN=http://127.0.0.1:4310
OPENSTEER_BIND_ADDRESS=127.0.0.1
OPENSTEER_PORT=4310
OPENSTEER_HOST_DATA_DIR=.opensteer/host
# Production should point this at a mounted 32-byte base64 key file.
# OPENSTEER_CREDENTIAL_KEY_PATH=/run/secrets/opensteer-credential-key
# Browser Runtimes use this private Host origin only for native readiness acknowledgement.
# Connected devices continue to use OPENSTEER_CANONICAL_ORIGIN over HTTPS.
# OPENSTEER_BROWSER_PROFILE_STATE_INTERNAL_URL=http://host:4310
# The default profile creates app-managed directories under .opensteer/workspaces, owned by the
# Runner. Host receives only the environment ID that names where new Workspaces go.
# No PortableFS process, mount, or Files service runs in this profile.
#
# For PortableFS integration work, change the backing and select exactly one authority topology:
# OPENSTEER_DEFAULT_WORKSPACE_BACKING=portablefs
# OPENSTEER_DEV_PORTABLEFS=local
# OPENSTEER_PORTABLEFS_SOURCE_DIR=/absolute/path/to/steerlabs/portablefs
#
# An external PortableFS deployment also requires its full Manager identity and Files origin:
# OPENSTEER_DEV_PORTABLEFS=external
# OPENSTEER_FILES_SERVICE_URL=https://files.opensteer.internal/
# OPENSTEER_PORTABLEFS_MANAGER_URL=https://manager.portablefs.internal:8443/
# OPENSTEER_PORTABLEFS_PRODUCT_ISSUER=opensteer
# OPENSTEER_WORKSPACE_DEFAULT_BLOCK_LIMIT_BYTES=536870912
# OPENSTEER_WORKSPACE_DEFAULT_INODE_LIMIT=50000
# OPENSTEER_PORTABLEFS_AUTHORIZATION_DOMAIN=opensteer-integration
# OPENSTEER_PORTABLEFS_SERVICE_ID=replace-with-the-manager-deployment-id
# OPENSTEER_PORTABLEFS_MANAGER_CA_PATH=/absolute/path/control-client-ca.pem
# OPENSTEER_PORTABLEFS_MANAGER_CERT_PATH=/absolute/path/opensteer-product.cert
# OPENSTEER_PORTABLEFS_MANAGER_KEY_PATH=/absolute/path/opensteer-product.key
# OPENSTEER_PORTABLEFS_MANAGER_SERVER_NAME=manager.portablefs.internal
# OPENSTEER_PORTABLEFS_PRODUCT_PRIVATE_KEY_PATH=/absolute/path/opensteer-product-signing.key
OPENSTEER_HOST_URL=http://127.0.0.1:4310
OPENSTEER_RUNNER_NAME=Main runner
OPENSTEER_RUNNER_DATA_DIR=.opensteer/runner
OPENSTEER_MAX_CONCURRENT_RUNS=4
# OPENSTEER_PORTABLEFS_MOUNT_BINARY=/absolute/path/to/portablefs

# Host-managed browser runtime started by the default source-development stack.
OPENSTEER_BROWSER_RUNTIME_ID=browser-main
OPENSTEER_BROWSER_ATTACH_KEY_ID=host-v1
OPENSTEER_BROWSER_HOST=127.0.0.1
OPENSTEER_BROWSER_PORT=4312
# Development derives these values; hosted/on-premise operators configure them explicitly.
# OPENSTEER_BROWSER_PROFILE_ROOT=/absolute/private/path/browser-profiles
# OPENSTEER_CHROMIUM_EXECUTABLE=/absolute/path/to/chromium
# OPENSTEER_BROWSER_ATTACH_PUBLIC_KEYS={"host-v1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
