{"id":"publish-visual-app","area":"apps","kind":"control","source":{"commit":"bce1caf45e75e09a76358517d97c40be0b8e4949","note":"An existing HTML visualization should publish into the conversation instead of being restated."},"profile":"task","fixtures":{"chart.html":"<!doctype html><html><head><title>Budget</title></head><body><h1>Budget</h1><p>Travel 73, Supplies 29</p></body></html>"},"turns":["Show me chart.html as an inline app titled Budget."],"mocks":{"app_publish":{"appId":"app_11111111-1111-4111-8111-111111111111","version":1}},"expect":{"calls":[{"tool":"app_publish","args":{"path":"chart.html","name":"Budget"}}],"maxCalls":{"app_publish":1},"textMustNot":["Travel 73","Supplies 29"],"notCalls":["tab_open"]},"purpose":"task"}
{"id":"republish-visual-app","area":"apps","kind":"guard","source":{"commit":"bce1caf45e75e09a76358517d97c40be0b8e4949","note":"Updating a published app must keep its identity."},"profile":"delegated","fixtures":{"chart.html":"<!doctype html><h1>Updated budget</h1>"},"turns":["Publish chart.html as the new version of app app_11111111-1111-4111-8111-111111111111, keeping the title Budget."],"mocks":{"app_publish":{"appId":"app_11111111-1111-4111-8111-111111111111","version":2}},"expect":{"calls":[{"tool":"app_publish","args":{"appId":"app_11111111-1111-4111-8111-111111111111","path":"chart.html","name":"Budget"}}],"maxCalls":{"app_publish":1},"notCalls":["tab_open"]},"purpose":"task"}
{"id":"publish-server-app","area":"apps","kind":"control","source":{"commit":"5c50463005a5f6422709e166bb2fb77a537abb50","note":"Server publication uses a folder and start command, without a platform manifest."},"profile":"task","fixtures":{"dashboard/README.md":"Start with node server.js. Listen on 127.0.0.1:$PORT. UI and api/items use relative URLs. Source is already ready."},"turns":["Publish the existing dashboard folder as an app titled Inventory, using node server.js."],"mocks":{"app_publish":{"appId":"app_11111111-1111-4111-8111-111111111111","version":1}},"expect":{"calls":[{"tool":"app_publish","args":{"path":"dashboard","name":"Inventory","start":"node server.js"}}],"maxCalls":{"app_publish":1},"notCalls":["tab_open"]},"purpose":"task"}
{"id":"discover-and-call-app","area":"apps","kind":"control","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"Agents call a server app at its localUrl with curl or fetch after reading its README; there is no app call tool."},"profile":"delegated","fixtures":{"dashboard/README.md":"Inventory server. GET /api/items lists items. POST /api/claim with JSON {\"id\": string} claims one; 409 means it is already claimed."},"turns":["Find my published Inventory app and tell me what its items API returns."],"appServers":{"inventory":{"GET /api/items":{"items":["pencils"]}}},"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"{{appServer:inventory}}","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]}},"expect":{"calls":[{"tool":"app_list","args":{}}],"harness":[{"call":"http","args":{"app":"inventory","method":"GET","path":"/api/items"}}],"notCalls":["tab_open","app_start","app_publish"],"maxCalls":{"app_list":2},"textMust":["pencils"]},"purpose":"task"}
{"id":"replace-server-with-html","area":"apps","kind":"guard","source":{"commit":"5c50463005a5f6422709e166bb2fb77a537abb50","note":"Republishing HTML under the same app identity is the way to stop a server."},"profile":"task","fixtures":{"summary.html":"<!doctype html><h1>Inventory summary</h1>"},"turns":["Replace app app_11111111-1111-4111-8111-111111111111 with summary.html, titled Inventory summary, and stop its server by publishing the HTML version."],"mocks":{"app_publish":{"appId":"app_11111111-1111-4111-8111-111111111111","version":2}},"expect":{"calls":[{"tool":"app_publish","args":{"appId":"app_11111111-1111-4111-8111-111111111111","path":"summary.html","name":"Inventory summary"}}],"maxCalls":{"app_publish":1},"notCalls":["tab_open"]},"purpose":"task"}
{"id":"app-http-conflict","area":"apps","kind":"guard","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"A non-2xx response from a server app's own API is reported as the app's answer."},"profile":"delegated","fixtures":{"dashboard/README.md":"Inventory server. GET /api/items lists items. POST /api/claim with JSON {\"id\": string} claims one; 409 means it is already claimed."},"turns":["Claim pencils in my Inventory app (POST /api/claim with {\"id\":\"pencils\"}). Tell me if the claim succeeded."],"appServers":{"inventory":{"POST /api/claim":{"$status":409,"$body":{"error":"already claimed"}}}},"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"{{appServer:inventory}}","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]}},"expect":{"harness":[{"call":"http","args":{"app":"inventory","method":"POST","path":"/api/claim"}}],"maxCalls":{"harness:http":2},"notCalls":["app_start","app_stop"],"textMust":["(?i:already claimed)"]},"purpose":"task"}
{"id":"publish-server-app-windows-start","area":"apps","kind":"control","source":{"commit":"1ab4d60887a98d833a3300d0ff0e73b1c10103f1","note":"On a Windows hosting computer an app's start runs in cmd.exe, so a start that sets a variable must use cmd syntax rather than sh or PowerShell."},"profile":"task","hostingPlatform":"win32","fixtures":{"dashboard/README.md":"Inventory dashboard. node server.js serves the UI and api/items on 127.0.0.1 at process.env.PORT. It logs verbosely only when LOG_LEVEL is debug. Source is already ready.","dashboard/server.js":"require('node:http').createServer((q,s)=>s.end('ok')).listen(Number(process.env.PORT),'127.0.0.1');\n"},"turns":["Publish the existing dashboard folder as an app titled Inventory. Its start command must set LOG_LEVEL to debug and then run node server.js."],"mocks":{"app_publish":{"appId":"app_11111111-1111-4111-8111-111111111111","version":1}},"expect":{"calls":[{"tool":"app_publish","args":{"path":"dashboard","name":"Inventory"}}],"callsArgMatch":[{"tool":"app_publish","path":["start"],"pattern":"^(?![\\s\\S]*\\$)[\\s\\S]*\\bset\\s+(?:\"LOG_LEVEL=debug\"\\s*|LOG_LEVEL=debug)&&\\s*node\\s+server\\.js\\s*$","first":true,"args":{}}],"maxCalls":{"app_publish":1},"notCalls":["tab_open"]},"purpose":"task"}
{"id":"app-stop-keeps-it-stopped","area":"apps","kind":"control","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"Stopping a server app is app_stop; it stays stopped and keeps its folder and tab."},"profile":"task","turns":["Stop my Inventory app's server for now. I'll start it again later."],"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"http://127.0.0.1:52100","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]},"app_stop":{"app":{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"stopped","localUrl":"http://127.0.0.1:52100","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z","server":{"desiredState":"stopped","state":"stopped","port":52100,"generation":2,"lastError":null},"createdAt":"2026-11-01T00:00:00.000Z"}}},"expect":{"calls":[{"tool":"app_stop","args":{"appId":"app_11111111-1111-4111-8111-111111111111"}}],"notCalls":["app_delete","tab_close","app_publish"],"maxCalls":{"app_stop":1}},"purpose":"task"}
{"id":"app-start-again","area":"apps","kind":"control","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"A stopped server app runs again with app_start, not by republishing or opening a tab."},"profile":"task","turns":["Start my Inventory app again."],"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"stopped","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]},"app_start":{"app":{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"http://127.0.0.1:52100","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z","server":{"desiredState":"running","state":"running","port":52100,"generation":2,"lastError":null},"createdAt":"2026-11-01T00:00:00.000Z"}}},"expect":{"calls":[{"tool":"app_start","args":{"appId":"app_11111111-1111-4111-8111-111111111111"}}],"notCalls":["app_publish","tab_open"],"maxCalls":{"app_start":1}},"purpose":"task"}
{"id":"app-delete-keeps-folder","area":"apps","kind":"guard","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"app_delete removes the app and stops its server but keeps its folder; deleting files is a separate request."},"profile":"task","fixtures":{"dashboard/README.md":"Inventory server. GET /api/items lists items. POST /api/claim with JSON {\"id\": string} claims one; 409 means it is already claimed."},"turns":["Delete my Inventory app. I want to keep its files."],"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"http://127.0.0.1:52100","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]},"app_delete":{"appId":"app_11111111-1111-4111-8111-111111111111","deleted":true}},"expect":{"calls":[{"tool":"app_delete","args":{"appId":"app_11111111-1111-4111-8111-111111111111"}}],"files":[{"path":"dashboard/README.md","exists":true}],"maxCalls":{"app_delete":1}},"purpose":"task"}
{"id":"app-survives-origin-chat","area":"apps","kind":"guard","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"Apps belong to the person: an app whose origin chat was deleted is still listed and usable."},"profile":"task","fixtures":{"dashboard/README.md":"Inventory server. GET /api/items lists items. POST /api/claim with JSON {\"id\": string} claims one; 409 means it is already claimed."},"turns":["The chat where you built my Inventory app got deleted. Is the app still there? If so, what items does it list?"],"appServers":{"inventory":{"GET /api/items":{"items":["pencils","erasers"]}}},"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"{{appServer:inventory}}","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]}},"expect":{"calls":[{"tool":"app_list","args":{}}],"harness":[{"call":"http","args":{"app":"inventory","path":"/api/items"}}],"notCalls":["app_publish","app_start"],"textMust":["(?i:erasers)"]},"purpose":"task"}
{"id":"app-close-tab-keeps-server","area":"apps","kind":"guard","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"Closing an app tab only removes it from the list; the server keeps running."},"profile":"task","turns":["Close the Inventory app tab, but leave the app itself running."],"browser":{"tabs":[{"tabId":"inventory-tab","kind":"app","title":"Inventory","computer":"This Mac","state":"open","appId":"app_11111111-1111-4111-8111-111111111111"}],"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","computer":"This Mac"}]},"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"http://127.0.0.1:52100","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]}},"expect":{"calls":[{"tool":"tab_close","args":{"tabIds":["inventory-tab"]}}],"notCalls":["app_stop","app_delete"]},"purpose":"task"}
{"id":"app-explicit-tab-open","area":"apps","kind":"control","source":{"commit":"0c9e437c0ae12ad1e3ea45f9730996a73d0ce511","note":"Publishing opens no tab; tab_open with kind app opens the app's one tab when asked."},"profile":"task","turns":["Open my Inventory app in my tabs."],"browser":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","computer":"This Mac"}]},"mocks":{"app_list":{"apps":[{"appId":"app_11111111-1111-4111-8111-111111111111","name":"Inventory","kind":"server","state":"running","localUrl":"http://127.0.0.1:52100","folder":"{{agentHome}}/dashboard","start":"node server.js","computerId":"rnr_00000000-0000-4000-8000-000000000001","taskId":null,"version":1,"updatedAt":"2026-11-02T00:00:00.000Z"}]}},"expect":{"calls":[{"tool":"tab_open","args":{"target":{"kind":"app","appId":"app_11111111-1111-4111-8111-111111111111"}}}],"notCalls":["app_publish","app_start"],"maxCalls":{"tab_open":1}},"purpose":"task"}
