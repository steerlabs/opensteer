{
  "name": "opensteer",
  "license": "MIT",
  "version": "0.1.219",
  "private": true,
  "description": "Private agents on your computer, shared chat and knowledge on your team server.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:agent-phone": "tsx scripts/build-agent-phone.ts",
    "check": "tsx scripts/check.ts",
    "clean": "pnpm -r --if-present clean",
    "desktop:public-release": "tsx scripts/desktop-public-release.ts",
    "desktop:install-local": "tsx scripts/install-mac-local.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:host": "pnpm --filter @opensteer/host dev",
    "dev:runner": "pnpm --filter @opensteer/runner dev",
    "dev:web": "pnpm --filter @opensteer/web dev",
    "engines": "tsx scripts/engines.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node tooling/oxlint-plugin-opensteer/baseline.mjs && oxlint . --deny-warnings && pnpm lint:type-aware",
    "lint:type-aware": "oxlint . -A all --type-aware -W typescript/no-floating-promises -D typescript/no-misused-promises",
    "prebuild": "pnpm --filter @opensteer/runner build:native-fs",
    "pretest": "pnpm --filter @opensteer/runner build:native-fs && pnpm --filter @opensteer/runner build:native-fs:test && pnpm --filter @opensteer/runner test:native-fs && pnpm --filter @opensteer/desktop build:process-supervisor",
    "reset:local-password": "pnpm --filter @opensteer/identity reset-local-password",
    "setup:local": "tsx scripts/setup-local.ts",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:agent-phone": "tsx scripts/test-integration.ts --config vitest.device.config.ts",
    "test:agent-phone:soak": "tsx scripts/test-integration.ts --config vitest.soak.config.ts",
    "test:engines": "tsx scripts/test-integration.ts --config vitest.engines.config.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:migration-compat": "tsx scripts/test-migration-compat.ts",
    "test:gui": "vitest run --config vitest.gui.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:tests",
    "typecheck:tests": "cd -P . && tsc -p tsconfig.tests.json --noEmit",
    "integration:rerun": "tsx scripts/integration-rerun.ts",
    "test:vm": "tsx scripts/test-vm.ts",
    "test:vm:golden": "tsx scripts/test-vm.ts --golden",
    "eval:agent-tools": "tsx evals/agent-tools/run.ts",
    "check:changed": "tsx scripts/check-changed.ts",
    "desktop:build-release": "tsx scripts/build-desktop-macos.ts",
    "bench:mobile-network": "tsx scripts/bench-mobile-network.ts",
    "bench:phone-display": "tsx scripts/bench-phone-display.ts",
    "bench:mac-display": "tsx scripts/bench-mac-display.ts",
    "bench:browser-stream": "tsx scripts/bench-browser-stream.ts",
    "dev:team": "OPENSTEER_DEPLOYMENT_KIND=team OPENSTEER_DEV_SERVICES=host,web tsx scripts/dev.ts",
    "init:team": "tsx scripts/init-team.ts",
    "verify:team-deployment": "node scripts/verify-team-deployment.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@opensteer/shared": "workspace:*",
    "@types/node": "26.2.0",
    "@types/ws": "catalog:",
    "app-builder-lib": "26.15.3",
    "esbuild": "0.28.2",
    "fastify": "catalog:",
    "kysely": "catalog:",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright-core": "1.62.1",
    "prettier": "3.9.6",
    "tsup": "catalog:",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "ws": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
