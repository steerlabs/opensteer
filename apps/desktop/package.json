{
  "name": "@opensteer/desktop",
  "version": "0.0.0",
  "description": "Opensteer desktop Host client and local Runner supervisor.",
  "desktopName": "opensteer.desktop",
  "author": "SteerLabs",
  "homepage": "https://github.com/steerlabs/opensteer",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm build:bundles && pnpm --filter @opensteer/web exec vite build --outDir ../desktop/dist/web --emptyOutDir false && node scripts/verify-runtime-imports.mjs",
    "build:bundles": "tsup --config tsup.config.ts",
    "build:computer-use-helper": "tsx scripts/build-computer-use-helper.ts",
    "build:passwords-broker": "tsx scripts/build-passwords-broker.ts",
    "build:process-supervisor": "tsx scripts/build-process-supervisor.ts",
    "clean": "rm -rf build/generated dist release generated-native generated-resources *.tsbuildinfo",
    "dev": "pnpm build && electron dist/main.js",
    "package:linux": "tsx scripts/package-linux.ts",
    "package:mac": "tsx scripts/package-macos.ts",
    "package:win": "tsx scripts/package-windows.ts",
    "prebuild": "pnpm build:process-supervisor && pnpm --filter @opensteer/browser-extension build",
    "prepare:release-resources": "tsx scripts/prepare-release-resources.ts",
    "preprepare:release-resources": "pnpm build:process-supervisor",
    "pretest": "pnpm build:process-supervisor && pnpm test:process-supervisor && pnpm test:personal-runtime-launcher",
    "start": "electron dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:electron-host-transport": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-host-transport-smoke.js",
    "test:electron": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-browser-smoke.js",
    "test:electron-cdp-boundary": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-cdp-boundary-smoke.js",
    "test:electron-attachments": "pnpm build && tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-attachment-smoke.js",
    "test:electron-profile-restore": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-profile-restore-smoke.js",
    "test:electron-cookies": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-browser-cookie-smoke.js",
    "test:electron-computer-use": "pnpm build:computer-use-helper && pnpm build:passwords-broker && pnpm build && tsup --config scripts/tsup.electron-smoke.config.ts && tsx scripts/test-support/build-passwords-policy-fixture.ts && pnpm test:electron-computer-use:run",
    "test:electron-computer-use:run": "electron .electron-smoke/electron-computer-use-smoke.js",
    "test:electron-display:run": "electron .electron-smoke/electron-display-smoke.js",
    "test:electron-cookies:run": "electron .electron-smoke/electron-browser-cookie-smoke.js",
    "test:electron-passkeys:run": "electron .electron-smoke/electron-browser-passkey-smoke.js",
    "test:electron-usb:run": "electron .electron-smoke/electron-usb-smoke.js",
    "test:electron-display": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-display-smoke.js",
    "test:electron-focus": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-browser-focus-smoke.js",
    "test:electron-passkeys": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-browser-passkey-smoke.js",
    "test:electron-passwords": "tsup --config scripts/tsup.electron-passwords-smoke.config.ts && electron .electron-smoke/electron-passwords-smoke.js",
    "test:electron-usb": "tsup --config scripts/tsup.electron-smoke.config.ts && electron .electron-smoke/electron-usb-smoke.js",
    "test:personal-runtime-launcher": "go -C personal-runtime-launcher test ./...",
    "test:process-supervisor": "go -C process-supervisor test ./...",
    "typecheck": "tsc --noEmit",
    "test:electron-quit": "tsup --config scripts/tsup.electron-smoke.config.ts && tsx scripts/test-electron-quit.ts",
    "build:electron-native-browser-smoke": "pnpm build:native-browser-journey",
    "test:electron-downloads": "tsup --config scripts/tsup.electron-smoke.config.ts && tsx scripts/test-electron-downloads.ts",
    "test:native-browser-journey": "node .electron-smoke/native-browser-journey.js",
    "build:native-browser-journey": "tsup --config scripts/tsup.electron-native-browser.config.ts",
    "test:electron-cdp-boundary:run": "electron .electron-smoke/electron-cdp-boundary-smoke.js",
    "test:electron-passwords:run": "electron .electron-smoke/electron-passwords-smoke.js",
    "test:electron-attachments:run": "electron .electron-smoke/electron-attachment-smoke.js",
    "test:electron-profile-restore:run": "electron .electron-smoke/electron-profile-restore-smoke.js",
    "test:electron-focus:run": "electron .electron-smoke/electron-browser-focus-smoke.js",
    "test:electron-host-transport:run": "electron .electron-smoke/electron-host-transport-smoke.js",
    "test:electron-browser:run": "electron .electron-smoke/electron-browser-smoke.js",
    "test:electron-idle:run": "OPENSTEER_IDLE_CPU_SMOKE=1 electron .electron-smoke/electron-browser-smoke.js",
    "test:electron-downloads:run": "tsx scripts/test-electron-downloads.ts",
    "test:electron-quit:run": "tsx scripts/test-electron-quit.ts",
    "package:mac:contributor": "tsx scripts/package-contributor-macos.ts",
    "build:dictation-helper": "tsx scripts/build-dictation-helper.ts",
    "build:passkeys-addon": "tsx scripts/build-passkeys-addon.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "0.116.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@opensteer/browser-core": "workspace:*",
    "@opensteer/browser-profile": "workspace:*",
    "@opensteer/browser-runtime-core": "workspace:*",
    "@opensteer/client": "workspace:*",
    "@opensteer/control-plane-protocol": "workspace:*",
    "@opensteer/core": "workspace:*",
    "@opensteer/integration-core": "workspace:*",
    "@opensteer/integration-catalog": "workspace:*",
    "@opensteer/runner-auth": "workspace:*",
    "@opensteer/runner-client": "workspace:*",
    "@opensteer/deployment-authority": "workspace:*",
    "@opensteer/shared": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-spawn": "7.0.6",
    "sharp": "catalog:",
    "shebang-command": "2.0.0",
    "typebox": "1.3.7",
    "which": "2.0.2",
    "ws": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "3.25.2",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@opensteer/protocol": "workspace:*",
    "@opensteer/runner": "workspace:*",
    "@opensteer/workspace-portablefs": "workspace:*",
    "@types/ws": "catalog:",
    "dmg-builder": "26.15.3",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "esbuild": "0.27.7",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@opensteer/browser-extension": "workspace:*",
    "@opensteer/harness": "workspace:*"
  }
}
