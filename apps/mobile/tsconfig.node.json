{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // The one file Node executes rather than Metro bundling: `app.config.ts`
    // reads the repository's release version off disk. It is kept out of the
    // application program so the app's own source can never reach a Node API.
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["app.config.ts"]
}
