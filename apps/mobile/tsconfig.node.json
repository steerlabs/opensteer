{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // Node configuration and native-test coordination stay separate from
    // the application program so app source cannot reach a Node API.
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["app.config.ts", "modules/phone-display/tests/native/serve.ts"]
}
