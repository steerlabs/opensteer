{
  "about": "RemoteInputEdits' arithmetic, run by RemoteInputEditsCasesTests.swift against the Swift and by tests/edits-cases.test.ts against the TypeScript port, so the two cannot drift. Offsets are UTF-16. Steps: place (name a place at [start, end] in the text as it stands), record ([start, removed, inserted]), settle, choose (a named place), and expectations: current (with the text's length), deletion and backspace (with the text), composedCount, chosenAfter, isBackspace, deletesSelection and deletedStart.",
  "cases": [
    {
      "name": "carets named at 0 before any edit land in typing order",
      "steps": [
        {
          "place": "first",
          "at": [0, 0]
        },
        {
          "place": "second",
          "at": [0, 0]
        },
        {
          "place": "third",
          "at": [0, 0]
        },
        {
          "record": [0, 0, 1]
        },
        {
          "current": "second",
          "length": 1,
          "is": [1, 1]
        },
        {
          "record": [1, 0, 1]
        },
        {
          "current": "third",
          "length": 2,
          "is": [2, 2]
        }
      ]
    },
    {
      "name": "typing over a selection twice leaves the second after the first",
      "steps": [
        {
          "place": "second",
          "at": [1, 4]
        },
        {
          "record": [1, 3, 1]
        },
        {
          "current": "second",
          "length": 3,
          "is": [2, 2]
        }
      ]
    },
    {
      "name": "a range ending where a later-applied replacement begins keeps it outside",
      "steps": [
        {
          "place": "word",
          "at": [0, 2]
        },
        {
          "record": [2, 1, 2]
        },
        {
          "current": "word",
          "length": 6,
          "is": [0, 2]
        }
      ]
    },
    {
      "name": "a range starting where an earlier removal ended follows it",
      "steps": [
        {
          "place": "word",
          "at": [3, 5]
        },
        {
          "record": [1, 2, 1]
        },
        {
          "current": "word",
          "length": 10,
          "is": [2, 4]
        }
      ]
    },
    {
      "name": "a range containing a replaced region grows and shrinks with it",
      "steps": [
        {
          "place": "range",
          "at": [0, 5]
        },
        {
          "record": [1, 2, 4]
        },
        {
          "current": "range",
          "length": 10,
          "is": [0, 7]
        }
      ]
    },
    {
      "name": "a word named for autocorrect is still that word after a space typed after it",
      "steps": [
        {
          "place": "word",
          "at": [0, 3]
        },
        {
          "record": [3, 0, 1]
        },
        {
          "current": "word",
          "length": 4,
          "is": [0, 3]
        }
      ]
    },
    {
      "name": "a replacement of the whole text moves waiting places to its end",
      "steps": [
        {
          "place": "caret",
          "at": [5, 5]
        },
        {
          "record": [0, 5, 0]
        },
        {
          "current": "caret",
          "length": 0,
          "is": [0, 0]
        },
        {
          "record": [0, 0, 2]
        },
        {
          "current": "caret",
          "length": 2,
          "is": [2, 2]
        }
      ]
    },
    {
      "name": "an edit after a place does not move it",
      "steps": [
        {
          "place": "range",
          "at": [1, 2]
        },
        {
          "record": [3, 1, 4]
        },
        {
          "current": "range",
          "length": 10,
          "is": [1, 2]
        }
      ]
    },
    {
      "name": "a typo then Backspace erases the typo",
      "steps": [
        {
          "isBackspace": {
            "named": [0, 1],
            "selection": [1, 0],
            "text": "a"
          },
          "is": true
        },
        {
          "place": "caret",
          "at": [1, 1]
        },
        {
          "record": [1, 0, 1]
        },
        {
          "backspace": "caret",
          "text": "ab",
          "is": [1, 1]
        }
      ]
    },
    {
      "name": "Backspace while nine wait erases the last of them",
      "steps": [
        {
          "place": "caret",
          "at": [1, 1]
        },
        {
          "record": [1, 0, 1]
        },
        {
          "record": [2, 0, 1]
        },
        {
          "record": [3, 0, 1]
        },
        {
          "record": [4, 0, 1]
        },
        {
          "record": [5, 0, 1]
        },
        {
          "record": [6, 0, 1]
        },
        {
          "record": [7, 0, 1]
        },
        {
          "record": [8, 0, 1]
        },
        {
          "record": [9, 0, 1]
        },
        {
          "backspace": "caret",
          "text": "0123456789",
          "is": [9, 1]
        }
      ]
    },
    {
      "name": "two Backspaces after a joined emoji and a typo erase the typo, then the emoji",
      "steps": [
        {
          "place": "first",
          "at": [6, 6]
        },
        {
          "place": "second",
          "at": [6, 6]
        },
        {
          "record": [6, 0, 1]
        },
        {
          "backspace": "first",
          "text": "a👩‍💻b",
          "is": [6, 1]
        },
        {
          "record": [6, 1, 0]
        },
        {
          "backspace": "second",
          "text": "a👩‍💻",
          "is": [1, 5]
        }
      ]
    },
    {
      "name": "Backspace at the start of the text deletes nothing",
      "steps": [
        {
          "place": "caret",
          "at": [0, 0]
        },
        {
          "backspace": "caret",
          "text": "abc",
          "is": [0, 0]
        }
      ]
    },
    {
      "name": "a Backspace is exactly one composed character ending at the caret",
      "steps": [
        {
          "isBackspace": {
            "named": [1, 5],
            "selection": [6, 0],
            "text": "a👩‍💻"
          },
          "is": true
        },
        {
          "isBackspace": {
            "named": [2, 2],
            "selection": [4, 0],
            "text": "xyab"
          },
          "is": false
        },
        {
          "isBackspace": {
            "named": [1, 1],
            "selection": [2, 0],
            "text": "é"
          },
          "is": false
        },
        {
          "isBackspace": {
            "named": [3, 1],
            "selection": [4, 0],
            "text": "ab"
          },
          "is": false
        },
        {
          "composedCount": {
            "text": "xyab",
            "range": [2, 2]
          },
          "is": 2
        },
        {
          "composedCount": {
            "text": "a👩‍💻",
            "range": [1, 5]
          },
          "is": 1
        },
        {
          "composedCount": {
            "text": "ab",
            "range": [1, 5]
          },
          "is": 0
        },
        {
          "composedCount": {
            "text": "ab",
            "range": [9223372036854775000, 9000]
          },
          "is": 0
        }
      ]
    },
    {
      "name": "a word deletion named while typing waits deletes the word it named",
      "steps": [
        {
          "place": "word",
          "at": [0, 5]
        },
        {
          "record": [5, 0, 1]
        },
        {
          "record": [6, 0, 1]
        },
        {
          "current": "word",
          "length": 7,
          "is": [0, 5]
        }
      ]
    },
    {
      "name": "a second deletion naming a word already deleted deletes nothing",
      "steps": [
        {
          "place": "first",
          "at": [8, 13]
        },
        {
          "place": "second",
          "at": [8, 13]
        },
        {
          "record": [8, 5, 0]
        },
        {
          "current": "second",
          "length": 8,
          "is": [8, 8]
        }
      ]
    },
    {
      "name": "a selection deleted twice deletes the character before it the second time",
      "steps": [
        {
          "deletesSelection": {
            "named": [1, 3],
            "selection": [1, 3]
          },
          "is": true
        },
        {
          "isBackspace": {
            "named": [1, 3],
            "selection": [1, 3],
            "text": "hello"
          },
          "is": false
        },
        {
          "place": "again",
          "at": [1, 4]
        },
        {
          "record": [1, 3, 0]
        },
        {
          "deletion": "again",
          "text": "ho",
          "is": [0, 1]
        }
      ]
    },
    {
      "name": "a replacement naming text already gone replaces nothing",
      "steps": [
        {
          "place": "replacement",
          "at": [2, 4]
        },
        {
          "record": [2, 2, 0]
        },
        {
          "current": "replacement",
          "length": 2,
          "is": [2, 2]
        }
      ]
    },
    {
      "name": "a deletion that names text away from the caret is not a Backspace",
      "steps": [
        {
          "isBackspace": {
            "named": [0, 1],
            "selection": [2, 0],
            "text": "abc"
          },
          "is": false
        }
      ]
    },
    {
      "name": "deleteBackward records where the characters actually went",
      "steps": [
        {
          "deletedStart": {
            "selection": [3, 0],
            "removed": 1
          },
          "is": 2
        },
        {
          "deletedStart": {
            "selection": [1, 3],
            "removed": 3
          },
          "is": 1
        },
        {
          "deletedStart": {
            "selection": [0, 0],
            "removed": 0
          },
          "is": 0
        }
      ]
    },
    {
      "name": "a selection chosen after an edit was named is the one to keep",
      "steps": [
        {
          "place": "typed",
          "at": [5, 5]
        },
        {
          "place": "tap",
          "at": [0, 0]
        },
        {
          "choose": "tap"
        },
        {
          "chosenAfter": "typed",
          "is": "tap"
        },
        {
          "chosenAfter": "tap",
          "is": null
        },
        {
          "place": "later",
          "at": [0, 0]
        },
        {
          "chosenAfter": "later",
          "is": null
        }
      ]
    },
    {
      "name": "settling forgets the edits so far",
      "steps": [
        {
          "record": [0, 0, 1]
        },
        {
          "settle": true
        },
        {
          "place": "caret",
          "at": [3, 3]
        },
        {
          "current": "caret",
          "length": 3,
          "is": [3, 3]
        }
      ]
    }
  ]
}
