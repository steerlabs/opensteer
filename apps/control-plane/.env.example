NODE_ENV=production
OPENSTEER_CONTROL_PLANE_HOST=127.0.0.1
OPENSTEER_CONTROL_PLANE_PORT=4142
OPENSTEER_CONTROL_PLANE_PUBLIC_URL=https://accounts.opensteer.example
OPENSTEER_CONTROL_PLANE_DATABASE_URL=postgresql://opensteer:replace-me@postgres/opensteer_account
OPENSTEER_CONTROL_PLANE_AUTH_SECRET=replace-with-at-least-32-random-characters

# Generate each operation key independently with:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
OPENSTEER_ADOPTION_OPERATION_KEY=replace-with-an-independent-32-byte-base64url-key
OPENSTEER_PERSONAL_ACCOUNT_LINK_OPERATION_KEY=replace-with-an-independent-32-byte-base64url-key

OPENSTEER_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
OPENSTEER_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
OPENSTEER_MANAGED_DEPLOYMENT_DOMAIN=connect.opensteer.example

# Hosted integration OAuth uses a separate provider application in every environment.
# See docs/integration-oauth.md for supported providers and registration requirements;
# Google is the example below. Leave the whole block absent to disable the broker.
# Generate the temporary-attempt key with the operation-key command above.
# Generate the X25519 private.public value with:
# node -e 'const c=require("node:crypto"),p=c.generateKeyPairSync("x25519");console.log(p.privateKey.export({format:"der",type:"pkcs8"}).toString("base64url")+"."+p.publicKey.export({format:"jwk"}).x)'
# OPENSTEER_HOSTED_OAUTH_STATE_KEY=replace-with-an-independent-32-byte-base64url-key
# OPENSTEER_HOSTED_OAUTH_ENCRYPTION_KEY=replace-with-x25519-private-dot-public
# OPENSTEER_HOSTED_OAUTH_GOOGLE_CLIENT_ID=replace-with-hosted-google-oauth-client-id
# OPENSTEER_HOSTED_OAUTH_GOOGLE_CLIENT_SECRET=replace-with-hosted-google-oauth-client-secret
# OPENSTEER_HOSTED_OAUTH_GOOGLE_REVISION=1

OPENSTEER_CONNECT_DOMAIN=opensteer-connect.example
OPENSTEER_CONNECT_CLOUDFLARE_ACCOUNT_ID=replace-with-32-lowercase-hex-characters
OPENSTEER_CONNECT_CLOUDFLARE_ZONE_ID=replace-with-32-lowercase-hex-characters
OPENSTEER_CONNECT_CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
OPENSTEER_CONNECT_CLOUDFLARE_WORKERS_ROUTE_BYPASS=off
OPENSTEER_CONNECT_CREDENTIAL_DERIVATION_SECRET=replace-with-an-independent-32-character-secret

# Direct push delivery to Apple and Google. Leave the whole block absent to run
# without push: registration answers `not_found` with reason
# `push-not-configured` and no Deployment publication becomes a notification.
# APNs and FCM are independent: configure either or both. Registration for a
# platform with no provider answers `push-not-configured`. APNs requires all four
# values below; one key serves sandbox and production, selected per device.
# OPENSTEER_APNS_KEY_ID is the ten-character key identifier Apple issues with
# the .p8; OPENSTEER_APNS_PRIVATE_KEY is that file's PKCS#8 PEM contents, with
# real newlines. The topic is the iOS bundle identifier.
# OPENSTEER_APNS_KEY_ID=replace-with-ten-character-apns-key-id
# OPENSTEER_APNS_TEAM_ID=replace-with-ten-character-apple-team-id
# OPENSTEER_APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OPENSTEER_APNS_TOPIC=com.opensteer.mobile
# The Firebase service account FCM v1 authenticates with, as its whole JSON
# document. The Firebase project id is read from it rather than declared twice.
# OPENSTEER_FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
