+    const directory = join(mountPoint, this.#base, "guests", slotKey, jailId);
+    const max = Number((await readFile(join(directory, "memory.max"), "utf8")).trim());
+    if (!Number.isSafeInteger(max)) return { restore: async () => {} };
+    const mib = 1024 * 1024;
+    const guest = (max - 512 * mib) / 2;
+    await writeFile(join(directory, "memory.high"), String(guest + 512 * mib));
+    return {
+      restore: () =>
+        writeFile(join(directory, "memory.high"), String(max)).catch(() => undefined),
+    };
+  }
