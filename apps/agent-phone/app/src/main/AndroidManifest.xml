<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held while the phone is paired, so heartbeats keep going with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Whatever app is in front is the phone's, and an observation names it as
      the launcher does: the launcher itself, the system UI behind the
      notification shade and apps with no launcher entry included, which no
      `<queries>` intent covers. `launch` opens any app with a launcher entry
      by package name. Lint's advice is for store apps; this one is sideloaded
      over USB and never distributed through a store.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".AgentPhoneApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentPhone">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".control.WakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="com.opensteer.agentphone.wake"
            android:theme="@style/Theme.AgentPhone.Invisible" />

        <activity android:name=".display.ProjectionActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="com.opensteer.agentphone.projection"
            android:theme="@style/Theme.AgentPhone.Invisible" />
        <service android:name=".display.ProjectionService" android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".control.AgentPhoneAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Setup's ADB control channel: only the shell and the system hold DUMP. -->
        <receiver
            android:name=".setup.SetupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.opensteer.agentphone.action.PAIR" />
                <action android:name="com.opensteer.agentphone.action.RETARGET" />
                <action android:name="com.opensteer.agentphone.action.STATUS" />
                <action android:name="com.opensteer.agentphone.action.UNPAIR" />
            </intent-filter>
        </receiver>

        <receiver android:name=".update.UpdateResultReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>

        <receiver
            android:name=".ui.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
