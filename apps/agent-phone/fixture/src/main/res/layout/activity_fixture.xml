<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- No text cursor: its blinking is screen motion that live display static
         measurements would count. Focus, selection and typing are unchanged. -->
    <EditText
        android:id="@+id/fixture_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:cursorVisible="false"
        android:hint="@string/text_hint"
        android:imeOptions="actionSend"
        android:importantForAutofill="no"
        android:inputType="text" />

    <EditText
        android:id="@+id/fixture_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:cursorVisible="false"
        android:hint="@string/password_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/fixture_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button" />

    <TextView
        android:id="@+id/fixture_long_press"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFE0E0E0"
        android:gravity="center"
        android:longClickable="true"
        android:text="@string/long_press"
        android:textColor="#FF000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fixture_drag"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFB3D4FC"
            android:gravity="center"
            android:longClickable="true"
            android:text="@string/drag"
            android:textColor="#FF000000" />

        <TextView
            android:id="@+id/fixture_drop_target"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#FFC8E6C9"
            android:gravity="center"
            android:text="@string/drop_target"
            android:textColor="#FF000000" />
    </LinearLayout>

    <ListView
        android:id="@+id/fixture_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
