{
  "manifest_version": 3,
  "name": "Opensteer",
  "description": "Lets your Opensteer agents use sites you're signed in to in Chrome, one site at a time, only after you allow it.",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "130",
  "incognito": "not_allowed",
  "permissions": ["alarms", "cookies", "notifications", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Opensteer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["connect.html", "icons/probe.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
