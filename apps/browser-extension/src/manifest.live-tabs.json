{
  "manifest_version": 3,
  "name": "Opensteer tab sharing",
  "description": "Let a connected agent act as you in a Chrome tab you share, until you stop sharing.",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "130",
  "incognito": "not_allowed",
  "permissions": [
    "alarms",
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["http://*/*", "https://*/*", "ws://*/*", "wss://*/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Opensteer tab sharing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["connect.html", "icons/probe.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
