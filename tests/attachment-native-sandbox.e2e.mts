import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { mkdtempSync, mkdirSync, readFileSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { CodexHarnessDriver } from "../packages/harness-codex/src/codex-driver.js";

// Uses the shipped Codex CLI and the exact profile generated by our driver.
if (process.platform !== "darwin") throw new Error("This probe requires macOS sandbox-exec");
const codex = resolve(
  fileURLToPath(new URL("../apps/runner/node_modules/@openai/codex/bin/codex.js", import.meta.url)),
);
const root = mkdtempSync(join(tmpdir(), "opensteer-attachment-native-"));
const cacheRoot = join(root, "cache");
const currentThread = join(cacheRoot, "current");
const siblingThread = join(cacheRoot, "sibling");
const privateRoot = join(root, "private");
for (const path of [
  cacheRoot,
  currentThread,
  siblingThread,
  privateRoot,
  join(privateRoot, "sqlite"),
])
  mkdirSync(path);
const currentFile = join(currentThread, "input.txt");
const siblingFile = join(siblingThread, "secret.txt");
const privateFile = join(privateRoot, "identity.txt");
writeFileSync(currentFile, "current-thread\n");
writeFileSync(siblingFile, "sibling-thread\n");
writeFileSync(privateFile, "runner-private\n");
const linkedSibling = join(currentThread, "sibling-link");
symlinkSync(siblingFile, linkedSibling);
const driver = new CodexHarnessDriver({
  launch: { executable: process.execPath, arguments: [codex] },
});
const result = {
  codexVersion: "",
  platform: process.platform,
  profiles: [] as Array<{
    mode: string;
    currentRead: boolean;
    siblingRead: boolean;
    linkedSiblingRead: boolean;
    privateRead: boolean;
    currentWrite: boolean;
  }>,
};
try {
  const version = spawnSync(process.execPath, [codex, "--version"], { encoding: "utf8" });
  assert.equal(version.status, 0, version.stderr);
  result.codexVersion = version.stdout.trim();
  for (const mode of ["approval-required", "auto", "full-access"] as const) {
    const wrap = await driver.modelCommandLaunch({
      accessMode: mode,
      attachmentDirectory: currentThread,
      attachmentRoot: cacheRoot,
      environment: { CODEX_SQLITE_HOME: join(privateRoot, "sqlite") },
      providerState: {
        continuationKey: "probe",
        kind: "ambient",
        privateStateRoot: privateRoot,
        providerHomeDirectory: undefined,
        store: { directory: join(privateRoot, "store"), id: "probe" },
      },
      runtimeBoundary: { kind: "isolated-service" },
      workspacePath: root,
      writableRoots: [root],
    });
    const run = (command: string, path: string) => {
      const launch = wrap({
        executable: "/bin/sh",
        args: ["-c", command, "_", path],
        cwd: root,
        environment: {},
      });
      return spawnSync(launch.executable, launch.args, {
        cwd: launch.cwd,
        encoding: "utf8",
        env: { ...process.env, ...launch.environment },
      });
    };
    const currentRead = run('cat "$1"', currentFile);
    const siblingRead = run('cat "$1"', siblingFile);
    const linkedSiblingRead = run('cat "$1"', linkedSibling);
    const privateRead = run('cat "$1"', privateFile);
    const currentWrite = run('printf changed >> "$1"', currentFile);
    assert.equal(currentRead.status, 0, `${mode}: ${currentRead.stderr}`);
    assert.equal(currentRead.stdout, "current-thread\n");
    assert.notEqual(siblingRead.status, 0, `${mode}: sibling file became readable`);
    assert.notEqual(linkedSiblingRead.status, 0, `${mode}: symlink escaped the current Thread`);
    assert.notEqual(privateRead.status, 0, `${mode}: private Runner state became readable`);
    assert.notEqual(currentWrite.status, 0, `${mode}: current attachment became writable`);
    assert.equal(readFileSync(currentFile, "utf8"), "current-thread\n");
    result.profiles.push({
      mode,
      currentRead: true,
      siblingRead: false,
      linkedSiblingRead: false,
      privateRead: false,
      currentWrite: false,
    });
  }
  const artifact = {
    ...result,
    sha256: createHash("sha256").update(JSON.stringify(result.profiles)).digest("hex"),
  };
  const output =
    process.env.OPENSTEER_SANDBOX_ARTIFACT ??
    join(tmpdir(), "opensteer-attachment-native-sandbox-e2e.json");
  writeFileSync(output, `${JSON.stringify(artifact, null, 2)}\n`);
  process.stdout.write(`${output}\n`);
} finally {
  rmSync(root, { recursive: true, force: true });
}
