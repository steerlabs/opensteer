diff --git a/android/src/main/java/org/webrtc/Dav1dDecoder.java b/android/src/main/java/org/webrtc/Dav1dDecoder.java
new file mode 100644
index 0000000000000000000000000000000000000000..5617f00641ac12c9b75bbff111e79ff2bdc9c42c
--- /dev/null
+++ b/android/src/main/java/org/webrtc/Dav1dDecoder.java
@@ -0,0 +1,23 @@
+/*
+ * Copyright (c) 2021 The WebRTC project authors. All Rights Reserved.
+ *
+ * Use of this source code is governed by a BSD-style license
+ * that can be found in LICENSE.webrtc in this directory.
+ */
+package org.webrtc;
+
+import org.jni_zero.NativeMethods;
+
+// The 155.0.1 AAR includes Dav1dDecoderJni and its native implementation but
+// omits this wrapper from sdk/android/api/org/webrtc in upstream jitsi/webrtc M155.
+public class Dav1dDecoder extends WrappedNativeVideoDecoder {
+    @Override
+    public long createNative(long webrtcEnvRef) {
+        return Dav1dDecoderJni.get().createDecoder();
+    }
+
+    @NativeMethods
+    interface Natives {
+        long createDecoder();
+    }
+}
